# Executes a system command safely, raises an exception if the command fails.
#-------------------------------------------------------------
module ShellUtils
  def self.safe_system(cmd, error_msg)
    debug_log "Running system command: #{cmd}" if defined?(debug_log)
    system(cmd) || raise("#{error_msg}\nCommand: #{cmd}")
  end
