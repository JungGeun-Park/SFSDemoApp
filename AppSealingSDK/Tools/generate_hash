module SecureFilesystem

    #----------------------------------------------------------------------------------------
    #    Logging (supports indent integer)
    #----------------------------------------------------------------------------------------
    def self.log(msg, color = :default, indent = 0)
        colors = {
            default: "\e[0m", red: "\e[31m", green: "\e[32m",
            yellow: "\e[33m", blue: "\e[34m", magenta: "\e[35m",
            cyan: "\e[36m", light_blue: "\e[94m", orange: "\e[38;5;208m"
        }

        color_code    = colors[color] || colors[:default]
        reset_code    = colors[:default]
        indent_spaces = ' ' * (4 * (indent.to_i))
        indented_msg  = indent_spaces + msg.to_s
        print "#{color_code}#{indented_msg}#{reset_code}\n"
    end

    #----------------------------------------------------------------------------------------
    #    SwiftSyntax package info / build helpers
    #----------------------------------------------------------------------------------------
    def self.determine_swiftsyntax_package
        swift_version = `swift --version 2>/dev/null`.lines.first&.
            match(/Apple Swift version (\d+\.\d+)/)&.captures&.first

        unless swift_version
            self.log("[ERROR] Could not determine Swift version from 'swift --version'", :red, 1)
            raise "Swift version detection failed"
        end

        major, _minor = swift_version.split(".").map(&:to_i)
        swiftsyntax_url = major >= 6 ? "https://github.com/apple/swift-syntax.git" : "https://github.com/apple/swiftsyntax.git"
        swiftsyntax_pkg = major >= 6 ? "swift-syntax" : "SwiftSyntax"
        swiftsyntax_ver = 'branch: "main"'
        [swiftsyntax_url, swiftsyntax_pkg, swiftsyntax_ver]
    end

    def self.swiftsyntax_cli_path
        if ENV['SCAN_SWIFT_AST_CLI'] && File.exist?(ENV['SCAN_SWIFT_AST_CLI'])
            return ENV['SCAN_SWIFT_AST_CLI']
        end

        default_cli = File.expand_path("ScanSwiftAST/.build/release/ScanSwiftAST", Dir.pwd)
        return default_cli if File.exist?(default_cli)

        global_cli = "/usr/local/bin/ScanSwiftAST"
        return global_cli if File.exist?(global_cli)

        nil
    end

    def self.swiftsyntax_project_dir
        File.expand_path("ScanSwiftAST", Dir.pwd)
    end

    #----------------------------------------------------------------------------------------
    #    Ensure ScanSwiftAST SwiftPM project (Package.swift + main.swift) exists.
    #----------------------------------------------------------------------------------------
    $scan_swift_ast_built = false

    def self.ensure_swiftsyntax_project!
        dir          = self.swiftsyntax_project_dir
        FileUtils.mkdir_p(dir)
        sources_dir  = File.join(dir, "Sources/ScanSwiftAST")
        FileUtils.mkdir_p(sources_dir)
        main_file    = File.join(sources_dir, "main.swift")
        package_file = File.join(dir, "Package.swift")

        swiftsyntax_url, swiftsyntax_pkg, swiftsyntax_ver = self.determine_swiftsyntax_package

        package_content = <<~PACKAGE
            // swift-tools-version:5.9
            import PackageDescription

            let package = Package(
                name: "ScanSwiftAST",
                platforms: [.macOS(.v13)],
                dependencies: [
                    .package(url: "#{swiftsyntax_url}", #{swiftsyntax_ver})
                ],
                targets: [
                    .executableTarget(
                        name: "ScanSwiftAST",
                        dependencies: [
                            .product(name: "SwiftSyntax", package: "#{swiftsyntax_pkg}"),
                            .product(name: "SwiftParser", package: "#{swiftsyntax_pkg}")
                        ],
                        path: "Sources/ScanSwiftAST"
                    )
                ]
            )
        PACKAGE

        File.write(package_file, package_content)
        File.write(main_file, MAIN_SWIFT_CONTENT)
    end

    #----------------------------------------------------------------------------------------
    #    Build ScanSwiftAST SwiftPM project once and return CLI path.
    #----------------------------------------------------------------------------------------
    def self.build_swiftsyntax_project!
        project_dir = self.swiftsyntax_project_dir
        sources_dir = File.join(project_dir, "Sources/ScanSwiftAST")
        main_file   = File.join(sources_dir, "main.swift")
        built_cli   = File.join(project_dir, ".build/release/ScanSwiftAST")

        need_build = false

        unless File.exist?(main_file)
            self.log(" ")
            self.log("** main.swift not found. Regenerating ScanSwiftAST project...", :yellow, 2)
            self.ensure_swiftsyntax_project!
            need_build = true
        else
            self.ensure_swiftsyntax_project!
        end

        need_build = true unless File.exist?(built_cli)

        if !need_build && $scan_swift_ast_built && File.exist?(built_cli)
            return built_cli
        end

        if need_build && $scan_swift_ast_built && File.exist?(built_cli)
            self.log("Build requested but already built in this run. Using existing CLI.", :yellow, 2)
            return built_cli
        end

        if need_build
            Dir.chdir(project_dir) do
                self.log("** Building ScanSwiftAST CLI from source...", :cyan, 2)
                self.log(" ")
                env = { "SWIFTPM_USE_LOCAL_BINARY_ARTIFACTS" => "1" }
                IO.popen(env, "swift build -c release 2>&1", "r") do |io|
                    io.each_line do |line|
                        line.chomp!
                        next if line.strip.empty?
                        next if line.start_with?("swift-driver version:")
                        print " \e[0m[Building SwiftSyntax] \e[32m#{line}\n"
                    end
                end

                unless $?.success?
                    self.log("[ERROR] SwiftPM build failed", :red, 1)
                    raise "SwiftPM build failed"
                end
            end
            $scan_swift_ast_built = true
        end

        built_cli
    end

    #----------------------------------------------------------------------------------------
    #    Helpers for source lookups / simple dataflow
    #----------------------------------------------------------------------------------------
    def self.code_line_at(file_path, line)
        begin
            @__swift_file_cache ||= {}
            @__swift_file_cache[file_path] ||= File.readlines(file_path)
            src = @__swift_file_cache[file_path][line - 1] || ""
            src.strip
        rescue
            ""
        end
    end

    #----------------------------------------------------------------------------------------
    #    Scan backwards from `line-1` up to `max_back` lines to find an assignment to varname
    #    returns the initializer expression string if found, else nil
    #----------------------------------------------------------------------------------------
    def self.find_initializer_expression(file_path, varname, line, max_back = 500)
        @__swift_file_cache ||= {}
        @__swift_file_cache[file_path] ||= File.readlines(file_path)

        lines   = @__swift_file_cache[file_path]
        idx     = [line - 2, lines.length - 1].min
        scanned = 0

        while idx >= 0 && scanned < max_back
            l = lines[idx]

            if (m = l.match(/(?:\b(?:let|var)\s+|^)\s*#{Regexp.escape(varname)}\s*(?::[^=]+)?=\s*(.+)$/))
                expr = m[1].strip
                expr = expr.gsub(/,\s*$/, '')
                return expr
            end

            idx     -= 1
            scanned += 1
        end

        nil
    end

    #----------------------------------------------------------------------------------------
    #    Determine likely runtime type from base expression text
    #----------------------------------------------------------------------------------------
    def self.resolve_type_from_expression(expr_text)
        return nil if expr_text.nil? || expr_text.strip.empty?

        txt = expr_text.dup
        txt = txt.gsub(/\s+/, ' ')

        return "NSData" if txt =~ /\bas\s+NSData\b/ || txt =~ /\bNS(Mutable)?Data\b/
        return "Data"   if txt =~ /\bData\(/ || txt =~ /\bData\./ || txt =~ /\bData\.\w+\(/
        return "Data"   if txt =~ /PropertyListSerialization\.data\b/i
        return "Data"   if txt =~ /JSONEncoder\(\)\.encode\b|\.encode\(.+JSONEncoder|PropertyListEncoder\b/i
        return "Data"   if txt =~ /\.data\s*\(.*\)/i && txt =~ /(PropertyList|plist|JSON|Encoder|encode)/i
        return "Data"   if txt =~ /Data\s*\(contentsOf/i
        return "NSData" if txt =~ /NSData\s*\(contentsOfFile|NSData\(contentsOf/i
        return "Data"   if txt =~ /\b[A-Za-z_]\w*Data\z/
        return "NSData" if txt =~ /\bnsData\b/i

        nil
    end

    #----------------------------------------------------------------------------------------
    #    Resolve type of base expression by text or initializer
    #----------------------------------------------------------------------------------------
    def self.resolve_base_type(file_path, base_text, line)
        return nil if base_text.nil? || base_text.strip.empty?

        b = base_text.strip
        b = b.gsub(/^\(+|\)+$/, '').strip

        t = self.resolve_type_from_expression(b)
        return t if t

        if b =~ /\A([A-Za-z_]\w*)\z/
            varname   = $1
            init_expr = self.find_initializer_expression(file_path, varname, line)
            if init_expr
                t2 = self.resolve_type_from_expression(init_expr)
                return t2 if t2
            end
        end

        nil
    end

    #----------------------------------------------------------------------------------------
    #    Class/name helpers
    #----------------------------------------------------------------------------------------
    def self.normalize_class_name(raw)
        raw = raw.to_s.strip

        return "NSData"        if raw.include?("NSData")
        return "NSMutableData" if raw.include?("NSMutableData")
        return "Data"          if raw == "Data" || raw.include?("Data(")
        return "FileHandle"    if raw.include?("FileHandle") ||
                                  raw.include?("NSFileHandle") ||
                                  raw.include?("NSConcreteFileHandle") ||
                                  raw =~ /\bhandle\b/i
        return "FileManager"   if raw.include?("FileManager") ||
                                  raw.include?("NSFileManager") ||
                                  raw =~ /\bfm\b/i
        return "InputStream"   if raw.include?("InputStream")
        return "OutputStream"  if raw.include?("OutputStream")

        raw
    end

    def self.io_class_for_member_base(base)
        base = base.to_s.strip

        return "FileManager"   if base.start_with?("FileManager")
        return "FileHandle"    if base.include?("FileHandle")
        return "InputStream"   if base.include?("InputStream")
        return "OutputStream"  if base.include?("OutputStream")
        return "NSData"        if base.include?("NSData") || base =~ /as\s+NSData/
        return "NSMutableData" if base.include?("NSMutableData")
        return "Data"          if base == "data" || base.include?("Data(")
        return "Data"          if base =~ /\bPropertyListSerialization\.data\b/i
        return "Data"          if base =~ /JSONEncoder\(\)\.encode\b|\.encode\s*\(.*JSONEncoder|PropertyListEncoder/i
        return "Data"          if base =~ /\b[A-Za-z_]\w*Data\z/

        nil
    end

    def self.io_class_for_declref(name, code)
        case name
        when "Data"
            return "Data" if code.include?("contentsOf") || code.start_with?("Data(")
        when "NSData"
            return "NSData" if code.start_with?("NSData(") || code.include?("contentsOf")
        when "NSMutableData"
            return "NSMutableData" if code.start_with?("NSMutableData(")
        when "InputStream"
            return "InputStream" if code.start_with?("InputStream(")
        when "OutputStream"
            return "OutputStream" if code.start_with?("OutputStream(")
        when "FileHandle"
            return "FileHandle" if code.start_with?("FileHandle(")
        end

        nil
    end

    def self.allow_always?(klass, method, arg0_text)
        return true if klass == "FileHandle" && method == "init"

        if klass == "FileHandle" && method == "write"
            txt = arg0_text.to_s

            return true if txt =~ /\bas\s+(NS)?Data\b/
            return true if txt =~ /\b(NS)?Data\s*\(.*\)/
            return true if txt =~ /\b[A-Za-z_]\w*Data\b/
            return true if txt =~ /JSONEncoder\(\)\.encode\b|PropertyListEncoder\b|PropertyListSerialization\.data\b/i
        end

        false
    end

    #----------------------------------------------------------------------------------------
    #    Detects Data.write(...) from serialization
    #----------------------------------------------------------------------------------------
    def self.detect_write_as_data(res, prev_res, file_path, indent = 0)
        title     = res['code'] || ""
        full      = res['full'] || ""
        base_text = res['base'] || ""
        line      = res['line'] || 0

        return nil unless title =~ /\.write\s*\(/ || full =~ /\.write\s*\(/

        if prev_res
            prev_code = prev_res['full'] || ""
            if prev_code =~ /PropertyListSerialization\.data/i ||
               prev_code =~ /JSONEncoder\(\)\.encode/i ||
               prev_code =~ /PropertyListEncoder/i
                return ["Data", "write"]
            end
        end

        if base_text =~ /\A([A-Za-z_]\w*)\z/
            var  = $1
            init = self.find_initializer_expression(file_path, var, line)
            if init =~ /PropertyListSerialization\.data|JSONEncoder|PropertyListEncoder/i
                return ["Data", "write"]
            end
        end

        if base_text =~ /\[[^\]]*\]/ || base_text =~ /\:[^\]]*\]/
            return ["Data", "write"]
        end

        nil
    end

    #----------------------------------------------------------------------------------------
    #    Scan a single Swift source file
    #----------------------------------------------------------------------------------------
    def self.scan_swift_file(file_path, indent = 2)
        swiftsyntax_cli = self.build_swiftsyntax_project!

        stdout, stderr, status = Open3.capture3(swiftsyntax_cli, file_path)
        unless status.success?
            self.log("[ERROR] SwiftSyntax scan failed: #{stderr}", :red, indent)
            return []
        end

        self.log(" ")
        self.log(" -- Scanning Swift file (ScanSwiftAST): #{file_path}", :default, indent)

        results = JSON.parse(stdout) rescue nil
        unless results.is_a?(Array)
            self.log("[ERROR] SwiftSyntax output parse failed or empty", :red, indent)
            return []
        end

        findings = []
        seen     = {}

        results.each_with_index do |res, idx|
            kind   = res['kind'] || ""
            base   = res['base'] || ""
            name   = res['name'] || ""
            code   = res['code'] || ""
            line   = res['line'] || 0
            arg0   = res['arg0'] || ""
            full   = res['full'] || ""
            labels = (res['argLabels'] || []).map(&:to_s)

            klass  = nil
            method = nil
            reason = nil

            if kind == "declRef" && UNSAFE_POSIX_FUNCS.include?(name)
                key = [file_path, line, 'POSIX', name, code]
                next if seen[key]
                seen[key] = true

                self.log(" ")
                self.log("\e[35mPOSIX function used:\e[33m #{name}\e[0m", :red, indent + 1)
                self.log("Line #{line}: #{self.code_line_at(file_path, line)}", :orange, indent + 2)

                findings << {
                    file: file_path,
                    line: line,
                    type: 'POSIX',
                    func: name
                }
                next
            end

            if klass.nil? && kind == "member" && name == "write"
                resolved_type = self.resolve_base_type(file_path, base, line)
                if resolved_type != "NSString"
                    if labels == %w[to atomically encoding]
                        klass  = "String"
                        method = "write"
                        reason = "String.write signature"
                    end
                end
            end

            if klass.nil? && kind == "declRef"
                first_label = code.match(/\b([a-zA-Z_][a-zA-Z0-9_]*)\s*:/)&.captures&.first
                if first_label == "contentsOf"
                    klass  = self.io_class_for_declref(name, code)
                    method = "init" if klass
                    reason = "Type(contentsOf:)"
                end
            end

            if klass.nil?
                prev_res    = idx > 0 ? results[idx - 1] : nil
                write_detect = self.detect_write_as_data(res, prev_res, file_path, indent + 1)
                if write_detect
                    klass, method = write_detect
                    reason        = "detect_write_as_data"
                end
            end

            if klass.nil?
                if kind == "member"
                    klass  = self.io_class_for_member_base(base)
                    method = name
                    reason = "member base"
                elsif kind == "declRef"
                    mapped = self.io_class_for_declref(name, code)
                    if mapped
                        klass  = mapped
                        method = "init"
                        reason = "io_class_for_declref"
                    end
                end
            end

            next unless klass
            next unless FILE_IO_CLASSES.include?(klass)
            next if self.allow_always?(klass, method, arg0)

            sensitive_list = SENSITIVE_METHODS[klass] || []
            next unless sensitive_list.include?(method)

            allowed = (ALLOWED_SWIFT_METHODS[klass] || [])
            if defined?(ALLOWED_OBJC_METHODS)
                ALLOWED_OBJC_METHODS.each do |objc_klass, methods|
                    allowed += methods if self.normalize_class_name(objc_klass) == klass
                end
            end

            next if allowed.include?(method)

            key = [file_path, line, klass, method, code]
            next if seen[key]
            seen[key] = true

            self.log(" ")
            self.log("Non-allowed method detected: \e[33m#{klass}.#{method}\e[0m", :red, indent + 1)
            self.log("Line #{line}: #{self.code_line_at(file_path, line)}", :orange, indent + 2)

            findings << {
                file:   file_path,
                line:   line,
                type:   'Swift',
                class:  klass,
                method: method,
                reason: reason
            }
        end

        self.log("\n") unless findings.empty?
        findings
    end

