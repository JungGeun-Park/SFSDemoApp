require "json"

module ApiUtils
  def self.create_http(uri)
    debug_log "create_http for uri=#{uri}"
    http = Net::HTTP.new(uri.hostname, uri.port)
    http.use_ssl = (uri.scheme == "https")
    return http unless http.use_ssl?

    http.verify_mode = OpenSSL::SSL::VERIFY_PEER
    store = OpenSSL::X509::Store.new
    store.set_default_paths
    http.cert_store = store
    http
  end

  # Checks if the HTTP response indicates success.
  # If not, extracts error details and raises a formatted, colorized exception.
  # - response: Net::HTTP response object
  # - api_phase: Symbol for the API phase (e.g., :sealing, :download)
  def self.handle_response(response, api_phase)
    debug_log "handle_response: phase=#{api_phase}, status=#{response.code}, class=#{response.class}"
    return if response.is_a?(Net::HTTPSuccess)

    # Attempt to extract server error message, fall back to body preview
    error_info = begin
        debug_log "Parsing error info from response body"
        JSON.parse(response.body).dig("result", "message") rescue response.body[0..200]
      end

    debug_log "API Error (phase=#{api_phase}): status=#{response.code}, message=#{error_info.inspect}"
    raise <<~ERROR.red.bold
            API Error (#{api_phase.to_s.upcase})
            - Status: #{response.code}
            - Message: #{error_info}
            - URI: #{response.uri}
          ERROR
  end
end

