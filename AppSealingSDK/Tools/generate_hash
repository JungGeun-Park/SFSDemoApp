#--------------------------------------------------------------------------------------------
# LicenseExtractor 클래스는 appsealing.lic 파일을 읽어 account ID 해시와 SDK 버전을 추출합니다.
# This class reads the appsealing.lic file to extract account ID hash and SDK version.
#--------------------------------------------------------------------------------------------
class LicenseExtractor
  attr_reader :account_id_hash, :sdk_version

  def initialize
    @account_id_hash = nil
    @sdk_version = nil
  end

  def extract_from_file(path)
    puts "    [INFO] Checking license file: #{path}".cyan
    debug_log "Checking license file at: #{path}"

    unless File.exist?(path)
      warn "[ERROR] License file not found: #{path}".red.bold
      debug_log "License file missing: #{path}"
      return
    end

    expected_magic = "\x41\x53\x4C\x46\x76".b # "ASLFv"
    debug_log "Expected magic string: #{expected_magic.inspect}"

    begin
      File.open(path, "rb") do |file|
        header = file.read(5)
        debug_log "Read license header: #{header&.unpack1("H*")}"
        puts "    [DEBUG] Magic header: #{header&.unpack1("H*")}".yellow
        unless header == expected_magic
          warn "[ERROR] Invalid license format: Magic number mismatch".red.bold
          debug_log "Magic number mismatch in license file"
          return
        end
        puts "    [INFO] Magic number check passed".cyan
        debug_log "Magic number check passed"

        file.read(3) # skip reserved
        debug_log "Skipped 3 reserved bytes"

        @sdk_version = file.read(48)&.gsub(/\x00/, "")
        puts "    [INFO] SDK Version: #{@sdk_version.inspect}".cyan
        debug_log "SDK version read: #{@sdk_version.inspect}"
        if @sdk_version.nil? || @sdk_version.empty?
          warn "[ERROR] Corrupted license: SDK version missing".red.bold
          debug_log "SDK version missing or empty"
          return
        end

        file.read(8) # skip reserved
        debug_log "Skipped 8 reserved bytes"

        account_hash_bin = file.read(32)
        debug_log "Read account hash: #{account_hash_bin&.unpack1("H*") rescue nil}"
        if account_hash_bin.nil? || account_hash_bin.bytesize != 32
          warn "[ERROR] Corrupted license: Account hash missing or wrong size".red.bold
          debug_log "Account hash missing or wrong size in license"
          return
        end

        @account_id_hash = account_hash_bin.unpack1("H*").upcase
        puts "    [INFO] Account ID Hash: #{@account_id_hash}".cyan
        debug_log "Extracted Account ID Hash: #{@account_id_hash}"
        puts "    [SUCCESS] License file parsing completed".green
      end
    rescue => e
      warn "[EXCEPTION] License parsing failed: #{e.message}"
      debug_log "Exception during license file parse: #{e.class} - #{e.message}"
      @account_id_hash = nil
    end
  end
end

