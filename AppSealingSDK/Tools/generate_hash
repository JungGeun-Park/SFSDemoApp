module StringUtils
  # Example: converts string param to hex string
  def self.to_hex_string(param)
    unpacked = param.unpack("H*").first
    unpacked.gsub(/(..)/, '\1').rstrip
  end

  #--------------------------------------------------------------------------------------------
  #  소스 코드 파일 내의 태깅 된 문자열 추출
  # Extract tagged strings within source code files
  #--------------------------------------------------------------------------------------------
  #--------------------------------------------------------------------------------------------
  #  appsealing.lic 파일 읽기
  #--------------------------------------------------------------------------------------------
  def self.get_accountID_hash_from_license_file(path)
    $account_id_hash = nil
    $sdk_version = nil

    puts "    [INFO] Checking license file: #{path}".cyan

    unless File.exist?(path)
      warn "[ERROR] License file not found: #{path}".red.bold
      return
    end

    expected_magic = "\x41\x53\x4C\x46\x76".b # "ASLFv"

    begin
      File.open(path, "rb") do |file|
        # Read and check magic header
        header = file.read(5)
        puts "    [DEBUG] Magic header: #{header&.unpack1("H*")}".yellow
        unless header == expected_magic
          warn "[ERROR] Invalid license format: Magic number mismatch".red.bold
          return
        end
        puts "    [INFO] Magic number check passed".cyan

        # Skip 3 bytes (reserved or unused)
        file.read(3)

        # Read SDK version (48 bytes), remove null bytes
        $sdk_version = file.read(48)&.gsub(/\x00/, "")
        puts "    [INFO] SDK Version: #{$sdk_version.inspect}".cyan
        if $sdk_version.nil? || $sdk_version.empty?
          warn "[ERROR] Corrupted license: SDK version missing".red.bold
          return
        end

        # Skip 8 bytes (reserved or unused)
        file.read(8)

        # Read 32 bytes for account ID hash
        account_hash_bin = file.read(32)
        if account_hash_bin.nil? || account_hash_bin.bytesize != 32
          warn "[ERROR] Corrupted license: Account hash missing or wrong size".red.bold
          return
        end

        # Convert binary hash to uppercase hex string and store in global variable
        $account_id_hash = account_hash_bin.unpack1("H*").upcase
        puts "    [INFO] Account ID Hash: #{$account_id_hash}".cyan
        puts "    [SUCCESS] License file parsing completed".green
      end
    rescue => e
      warn "[EXCEPTION] License parsing failed: #{e.message}"
      $account_id_hash = nil
    end
    return {
        sdk_version: $sdk_version,
        account_id_hash: $account_id_hash
      }
  end

  def self.generate_c_array(hex_str, expected_size)
      bytes = hex_str.scan(/../)
      if bytes.size != expected_size
          raise "Invalid hex string size: expected #{expected_size}, got #{bytes.size}"
      end
      bytes.map { |b| "0x#{b}" }.join(', ')
  end
  
  #--------------------------------------------------------------------------------------------
  #  Extract AppSealing license from Unreal executable (FAST VERSION)
  #--------------------------------------------------------------------------------------------
  def self.get_accountID_hash_from_unreal_executable(path)
    require "stringio"
    $current_step ||= 0
    $bundle_id ||= ""
    $sdk_version ||= ""
    $account_id_hash = nil
    $isUnreal ||= false

    $current_step += 1
    puts "\n[STEP #{$current_step += 1}] Extracting account ID from executable file...".bold.yellow

    unless File.exist?(path)
      warn "    [ERROR] File not found: #{path}".red.bold
      exit(false)
    end

    file_size = File.size(path)
    puts "    [DEBUG] File size: #{file_size} bytes".yellow

    $position = 0
    parse_finished = false

    magic1 = "\x41\x53\x4C\x46".b
    magic2 = "\x76\x34\x0A\x0D".b
    zero4 = "\x00\x00\x00\x00".b
    chunk_size = 4 * 1024 * 1024
    puts "    [DEBUG] Using chunk size: #{chunk_size} bytes".yellow

    position_mutex = Mutex.new

    uiThread = Thread.new do
      begin
        last_reported_percent = -1
        loop do
          current_pos = position_mutex.synchronize { $position }
          percent = (current_pos.to_f / file_size) * 100
          percent = percent.round # 정수 %로 변환

          # 1% 단위로만 출력 또는 최종 100% 강제 출력
          if percent > last_reported_percent || current_pos >= file_size
            formatted_pos = current_pos.to_s.reverse.gsub(/(\d{3})(?=\d)/, '\\1,').reverse
            formatted_percent = sprintf("%d%%", [percent, 100].min)
            print "\r    [INFO] Progress: #{formatted_pos}/#{file_size} (#{formatted_percent})".cyan
            last_reported_percent = percent
          end

          sleep 0.1
          break if parse_finished || current_pos >= file_size
        end

        # 마지막에 줄바꿈 추가
        formatted_pos = file_size.to_s.reverse.gsub(/(\d{3})(?=\d)/, '\\1,').reverse
      rescue => e
        warn "    [WARN] UI thread error: #{e.message}".yellow
      end
    end

    parseThread = Thread.new do
      begin
        File.open(path, "rb") do |f|
          buffer = "".b
          total_read = 0
          chunk_count = 0
          last_percent = 0
          while chunk = f.read(chunk_size)
            chunk_count += 1
            buffer << chunk
            total_read += chunk.bytesize
            search_from = 0
            magic_found = 0

            while (idx = buffer.index(magic1, search_from))
              magic_found += 1
              global_pos = total_read - buffer.bytesize + idx

              position_mutex.synchronize { $position = global_pos }

              if buffer.bytesize < idx + 256 + 96
                buffer = buffer[idx..-1]
                break
              end

              # Magic2 검증
              if buffer[idx + 4, 4] != magic2
                search_from = idx + 1
                next
              end

              # Zero4 검증
              if buffer[idx + 51, 4] != zero4
                search_from = idx + 1
                next
              end

              # 데이터 추출
              sdk_bytes = buffer[idx + 8, 49]
              $sdk_version = sdk_bytes.gsub(/\000/, "")
              puts "\n\n  • SDK version: #{$sdk_version}"

              account_bytes = buffer[idx + 64, 32]
              if account_bytes&.bytesize == 32
                $account_id_hash = account_bytes.unpack1("H*")
                puts "  • Account hash: #{$account_id_hash[0..10]}..."
              else
                warn "    [WARN] Invalid account hash data at position #{global_pos + 64}".yellow
              end

              bundle_bytes = buffer[idx + 96, 256]
              $bundle_id = bundle_bytes.strip
              puts "  • Bundle ID: #{$bundle_id}"

              if $account_id_hash && !$account_id_hash.empty?
                parse_finished = true
                $isUnreal = true
                puts "    [INFO] Valid license found!".green
                break
              end

              search_from = idx + 1
            end
            percent = (total_read.to_f / file_size) * 100
            if percent.to_i > last_percent
              sleep 0.1
              last_percent = percent.to_i
            end
            break if parse_finished

            # 버퍼 관리
            keep_bytes = [buffer.bytesize, 256 + 96].min
            position_mutex.synchronize { $position = total_read - keep_bytes }
            buffer = buffer[-keep_bytes..-1] || "".b
          end
        end
      rescue => e
        warn "    [ERROR] Parsing error: #{e.message}".red.bold
        puts e.backtrace.first(5).join("\n")
      ensure
        parse_finished = true
        position_mutex.synchronize { $position = file_size }
      end
    end

    parseThread.join
    uiThread.join

    unless $account_id_hash && !$account_id_hash.empty?
      warn "\n    [ERROR] Failed to extract AppSealing account ID".red.bold
      warn "    [ERROR] Possible causes:".red.bold
      warn "    - Magic headers not found in binary".red
      warn "    - File is not an AppSealing-protected Unreal executable".red
      warn "    - License data corrupted".red
      exit(false)
    end

    return {
      sdk_version: $sdk_version,
      account_id_hash: $account_id_hash
    }
  end
end


#--------------------------------------------------------------------------------------------
# StringEncryption: 문자연 암호화 라이브러리
# This module contains helper functions for string encryption.
#--------------------------------------------------------------------------------------------

module StringEncryption
    # Extract all tagged hex strings from a given file path.
  # - Reads the file in binary mode for robust encoding.
  # - Returns an array of hex strings for every valid tagged string found (at least 20 bytes, with specific tag pattern).
  # - Skips files with names ending in "AppsealingiOS.mm" or "LEASection.mm".
  # - On encoding or critical error, prints an error and exits.
  def self.extract_tagged_strings(path)
    debug_log "extract_tagged_strings called with path=#{path}"
    result = []
    return result if path.end_with?("AppsealingiOS.mm")
    return result if path.end_with?("LEASection.mm")

    puts "    [INFO] Processing file: #{path}".cyan
    debug_log "Processing file: #{path}"
    begin
      # 파일 인코딩 처리 강화 (UTF-8, ASCII-8BIT)
      # Enhance file encoding handling (UTF-8, ASCII-8BIT)
      # Use binary and strict encoding to help avoid misreads on files with embedded non-ASCII or binary data.
      debug_log "About to read file: #{path}"
      content = File.read(path, mode: "rb", encoding: "ASCII-8BIT").scrub
      debug_log "File read: #{path} (#{content.bytesize} bytes)"
      matches = content.scan(/("(?:\\"|[^"])*\\0x1\\0x1\\0x1\\0x1")/).flatten
      debug_log "Read file, found #{matches.size} candidate tagged string(s)"

      matches.each do |match|
        # 유효성 검사: 최소 길이 20자(예: "abc\x01..." + 16바이트 태그)
        # Validation: Minimum length 20 characters (e.g., "abc\x01..." + 16-byte tag)
        # Ensures each match is not a short accidental string; avoids false positives and improves robustness.
        next unless match.bytesize >= 20

        # 이스케이프 처리 제거
        # Remove escape processing
        # Strip out the trailing tag, remove quotes and escape artifacts to get clean payload.
        clean_str = match.gsub(/\\0x1\\0x1\\0x1\\0x1"$/, "")[1..-1]
        hex_str = clean_str.unpack1("H*")
        debug_log "Found tagged string: #{clean_str} (#{hex_str[0..20]}...)" # Adds details for each

        puts "    [DEBUG] Found tagged string: #{clean_str} : #{hex_str[0..20]}...".yellow
        result << hex_str
      end

      if result.any?
        debug_log "extract_tagged_strings: extracted #{result.size} strings"
      else
        debug_log "extract_tagged_strings: found no tagged strings"
      end

      puts "    [INFO] Found #{result.size} valid tagged strings"
    rescue EncodingError => e
      debug_log "Encoding error: #{e.class} - #{e.message}"
      # 인코딩 에러 발생 시
      # If encoding error occurs
      # This block triggers on legacy files or those with invalid byte sequences, so the user gets a clear message.
      puts "    [ERROR] Encoding error in #{path}: #{e}".red
      exit(1)
    rescue => e
      debug_log "Other failure: #{e.class} - #{e.message}"
      # 기타 치명적인 예외 처리
      # Handle other critical exceptions
      # All uncaught exceptions are logged and surfaced with file and error context for clarity on exit.
      puts "    [ERROR] Critical error processing #{path}: #{e}".red
      puts "           Check file syntax or special characters".red
      exit(1)
    end

    result
  end

  #--------------------------------------------------------------------------------------------
  #  문자열 암호화
  # String encryption
  #--------------------------------------------------------------------------------------------
  # Modifies a .mm file in AppSealingSDK/Libraries to inject updated IV/key/key_table for LEA.
  # 1. Creates a backup, 2. Modifies LEA AREA code block, 3. Atomically writes changes, 4. Restores backup on error
  def self.modify_lea_area(path, src, iv, key)
    debug_log "modify_lea_area called with path=#{path}, src=#{src}"
    mm_path = File.join(path, "AppSealingSDK", "Libraries", src)
    debug_log "Target file: #{mm_path}"
    unless File.exist?(mm_path)
      puts "    [ERROR] Cannot find #{src}: #{mm_path}".red
      debug_log "File not found: #{mm_path}"
      exit(1)
    end

    puts "    [INFO] Modifying #{src}...".cyan
    debug_log "Modifying #{src}..."

    begin
      # 1. 백업 파일 생성
      # 1. Create a backup of the original file before modifying
      backup_path = "#{mm_path}.org"
      debug_log "Creating backup: #{backup_path}"
      FileUtils.cp(mm_path, backup_path)
      puts "    [INFO] Backup created: #{backup_path}".cyan

      # 2. 파일 수정
      # 2. Read and modify the file, injecting new LEA parameters
      debug_log "Beginning file modification for LEA injection"
      modified_source = []
      line_add = true

      File.foreach(mm_path, chomp: true) do |line|
        debug_log "Reading line: #{line}" if $debug_mode && (line.include?("LEA AREA BEGIN") || line.include?("LEA AREA END"))
        if line.strip.end_with?("///// LEA AREA END : DO NOT DELETE THIS LINE !!!!")
          line_add = true
          modified_source << line
          debug_log "Reached LEA AREA END marker"
          next
        end

        unless line.strip.end_with?("///// LEA AREA BEGIN : DO NOT DELETE THIS LINE !!!!")
          modified_source << line if line_add
          next
        end

        # 3. 신규 코드 블록 생성
        # 3. Insert the updated IV, key, and key_table just after LEA AREA BEGIN marker
        debug_log "Injecting new LEA code block after BEGIN marker"
        modified_source << line
        modified_source << "unsigned char __se_iv[16] = { #{StringUtils.generate_c_array(iv, 16)} };"
        modified_source << "bool __se_use_lea = #{LOCAL_TEST ? "false" : "true"};"

        debug_log "__se_use_lea flag: #{LOCAL_TEST ? "false" : "true"} (LOCAL_TEST=#{LOCAL_TEST})"

        if LOCAL_TEST
          debug_log "Injecting LOCAL_TEST key/key_table"
          modified_source << "unsigned char __se_key_table[248620];"
          modified_source << "unsigned char __se_key[16] = { #{StringUtils.generate_c_array(key, 16)} };"
        else
          debug_log "Injecting production key/key_table"
          modified_source << "unsigned char __se_key[16];"
          modified_source << "unsigned char __se_key_table[248620] = { #{StringUtils.generate_c_array(key, 248620)} };"
        end

        line_add = false
      end

      # 4. 원자적 쓰기 (임시 파일 -> 원본 파일)
      # 4. Atomically replace file: write tmp first, then rename
      temp_path = "#{mm_path}.tmp"
      debug_log "Writing temporary file: #{temp_path}"
      File.write(temp_path, modified_source.join("\n"))
      File.rename(temp_path, mm_path)
      puts "    [INFO] #{src} updated successfully.".cyan
      debug_log "#{src} updated successfully."
    rescue => e
      # 5. 에러 발생 시 백업 복원
      # 5. If anything fails, restore from backup and log
      debug_log "Exception: #{e.class} - #{e.message}"
      puts "    [ERROR] Failed to update #{src}: #{e}".red
      if File.exist?(backup_path)
        debug_log "Restoring from backup: #{backup_path}"
        FileUtils.cp(backup_path, mm_path)
        puts "    [INFO] Restored original file from backup.".cyan
      end
      exit(1)
    end
  end

  #--------------------------------------------------------------------------------------------
  #  문자열 암호화 요청 및 처리
  # Request and process string encryption from local AES or AppSealing server.
  # - Encrypts a list of strings using LOCAL_TEST AES/IV or by sending to the server.
  # - Loads account_id_hash, manages local/prod mode, inserts debug tracing.
  # - Modifies AppsealingiOS.mm & LEASection.mm with the new IV and key/table.
  # - Returns map of input string → encrypted hex string.
  #--------------------------------------------------------------------------------------------
  def self.get_encrypted_strings(path, param)
    require "securerandom"
    require "openssl"
    require "json"
    require "net/http"
    require "uri"

    enc_strings_map = {}

    lic_path = File.join(path, "AppSealingSDK", "Libraries", "appsealing.lic")
    debug_log "Loading license file for account ID hash: #{lic_path}"
    StringUtils.get_accountID_hash_from_license_file(lic_path)
    puts "    [INFO] Loaded account_id_hash: #{$account_id_hash}".cyan
    debug_log "Loaded account_id_hash: #{$account_id_hash}"

    if LOCAL_TEST
      # LOCAL_TEST mode - use random AES key/IV
      $iv      = SecureRandom.hex(16).upcase
      $aes_key = SecureRandom.hex(16).upcase
      puts "    [INFO] LOCAL_TEST enabled - Using random AES key/IV".cyan
      debug_log "LOCAL_TEST is enabled: IV=#{$iv}, AES_KEY=#{$aes_key}"

      param.each do |string|
        begin
          debug_log "Encrypting string in LOCAL_TEST: #{string[0..20]}..."
          aes = OpenSSL::Cipher::AES.new("128-CTR")
          aes.encrypt
          aes.key = [$aes_key].pack("H*")
          aes.iv  = [$iv].pack("H*")
          enc = aes.update(string) + aes.final
          key = StringUtils.to_hex_string(string).upcase
          enc_strings_map[key] = StringUtils.to_hex_string(enc).upcase
          debug_log "Encrypted string key: #{key[0..20]}... → value: #{enc_strings_map[key][0..20]}..."
        rescue => e
          puts "    [ERROR] AES encryption failed for string: #{string[0..10]}... (#{e})".red
          debug_log "AES encryption failed for #{string[0..10]}...: #{e.class} - #{e.message}"
        end
      end
      puts "    [INFO] Local encryption complete: #{enc_strings_map.size} strings".cyan
      debug_log "Local encryption complete for #{enc_strings_map.size} strings"
    else
      # Request string encryption from AppSealing server
      uri = URI(File.join($baseURL, "v3/sdk/requestStringEncryptionForIOS"))

      begin
        puts "    [INFO] Requesting string encryption from AppSealing server...".cyan
        debug_log "Posting string encryption request to: #{uri}"

        request   = Net::HTTP::Post.new(uri)
        form_data = [
          ["bundle_id",       $bundle_id],
          ["account_id_hash", $account_id_hash],
          ["strings",         param.join(",")],
        ]
        request.set_form form_data, "multipart/form-data"

        http     = ApiUtils.create_http(uri)
        response = http.start { |h| h.request(request) }

        debug_log "Server responded: status #{response.code rescue 'N/A'}, body: #{response.body[0..100]}"
        result  = JSON.parse(response.body)
        code    = result.dig("result", "code")
        message = result.dig("result", "message")

        if code != "0000"
          puts "    [ERROR] AppSealing server error: #{message}".red
          puts "           If this error occurs continuously, contact AppSealing Help Center.".red
          debug_log "AppSealing server returned error: #{code} - #{message}"
          exit(1)
        end

        $iv            = result["iv"]
        $lea_key_table = result["lea_key_table"]
        enc_strings_map = result["encrypted_strings"]
        debug_log "Received IV: #{$iv}, LEA key/table length: #{$lea_key_table&.size}"
        puts "    [INFO] Server encryption complete: #{enc_strings_map.size} strings".cyan
      rescue => e
        puts "    [ERROR] Cannot connect to AppSealing server or bad response.".red
        puts "           [Error] #{e}".red
        puts "           If this error occurs continuously, contact AppSealing Help Center.".red
        debug_log "Server communication exception: #{e.class} - #{e.message}"
        exit(1)
      end
    end

    # Update AppSealing source (.mm) files with new IV and key table
    debug_log "Updating AppsealingiOS.mm and LEASection.mm with IV/key"
    modify_lea_area(path, "AppsealingiOS.mm", $iv, LOCAL_TEST ? $aes_key : $lea_key_table)
    modify_lea_area(path, "LEASection.mm",    $iv, LOCAL_TEST ? $aes_key : $lea_key_table)

    debug_log "Encrypted strings map ready (#{enc_strings_map.size} entries returned)"
    enc_strings_map
  end

  #--------------------------------------------------------------------------------------------
  # 문자열 교체
  # Replace string
  #--------------------------------------------------------------------------------------------
  # Replaces obfuscated/tagged strings in the given file.
  def self.replace_tagged_strings(path)
    puts "    [INFO] Processing file: #{path}".cyan

    # Create backup
    backup_path = "#{path}.org"
    FileUtils.cp(path, backup_path)
    puts "    [DEBUG] Backup created: #{backup_path}".yellow

    begin
      content = File.read(path, encoding: "UTF-8")
      modified = content.dup
      tag = '\\0x1\\0x1\\0x1\\0x1'
      index = 0
      replacement_count = 0

      # Search for tags in the entire contents
      while (index = modified.index(tag, index))
        puts "    [DEBUG] Found tag at position: #{index}".yellow

        # Search for string start position
        start_pos = index - 1
        while start_pos >= 0
          break if modified[start_pos] == '"' && (start_pos == 0 || modified[start_pos - 1] != '\\')
          start_pos -= 1
        end

        if start_pos < 0
          puts "    [WARN] Invalid string format before tag at #{index}".yellow
          index += tag.length
          next
        end

        # Extract strings
        original_str = modified[start_pos + 1...index]
        hex_key = original_str.unpack1("H*").downcase
        puts "    [DEBUG] Original string: #{original_str[0..50]}...".yellow
        puts "    [DEBUG] Hex key: #{hex_key[0..24]}...".yellow

        unless $enc_strings[hex_key]
          puts "    [WARN] Missing encryption key for: #{hex_key[0..24]}...".yellow
          index += tag.length
          next
        end

        # Create replacement strings
        replacement = if path.end_with?(".m", ".mm")
            if modified[start_pos - 1] == "@"
              "[AppSealingInterface _DSS:@\"#{$enc_strings[hex_key]}\"]"
            else
              "[[AppSealingInterface _DSC:\"#{$enc_strings[hex_key]}\"] UTF8String]"
            end
          else
            "String(AppSealingInterface._DSS(\"#{$enc_strings[hex_key]}\"))"
          end

        # Apply replacement
        if path.end_with?(".m", ".mm") && modified[start_pos - 1] == "@"
          modified[(start_pos - 1)..(index + tag.length)] = replacement
        else
          modified[(start_pos)..(index + tag.length)] = replacement
        end

        replacement_count += 1
        puts "    [DEBUG] Replaced with: #{replacement[0..50]}...".yellow

        index = start_pos + replacement.length # Offset position for next search
      end

      # Check whether replacement was here
      if replacement_count == 0
        puts "    [WARN] No tagged strings replaced in file".yellow
        return
      end

      # Atomically write
      temp_path = "#{path}.tmp"
      File.write(temp_path, modified)
      File.rename(temp_path, path)
      puts "    [INFO] Successfully replaced #{replacement_count} strings".green
    rescue => e
      puts "    [ERROR] Critical error: #{e}".red
      FileUtils.cp(backup_path, path) if File.exist?(backup_path)
      exit(1)
    ensure
      FileUtils.rm_f(temp_path) rescue nil
    end
  end

  #--------------------------------------------------------------------------------------------
  #  원본 코드 복원
  # Restore original code file from backup (.org).
  # - Atomically replaces the main file with its backup if it exists.
  # - Cleans up any temp files, and (optionally) deletes the backup after restore.
  # - On error, tries to revert from temp file.
  #--------------------------------------------------------------------------------------------
  def self.restore_original_code(path)
    debug_log "restore_original_code called with path=#{path}"
    backup_path = "#{path}.org"

    unless File.exist?(backup_path)
      puts "    [WARN] Backup file not found: #{backup_path}".yellow
      debug_log "No backup to restore for: #{backup_path}"
      return
    end

    begin
      puts "    [INFO] Restoring original file: #{backup_path} => #{path}".cyan
      debug_log "Restoring: backup_path=#{backup_path}, dest_path=#{path}"

      # 1. 원자적 복구 (임시 파일 사용)
      # Atomic restore (using a temp file)
      temp_path = "#{path}.tmp"
      FileUtils.mv(path, temp_path) if File.exist?(path)  # 현재 파일 임시 이동
      debug_log "Moved current file to temp: #{temp_path}" if File.exist?(temp_path)
      FileUtils.mv(backup_path, path)                     # 백업 → 원본
      debug_log "Backup file moved to active path"

      # 2. 임시 파일 정리
      # Clean up temporary file (safe to ignore if missing)
      FileUtils.rm_f(temp_path) rescue nil

      puts "    [INFO] Successfully restored: #{path}".green
      debug_log "Successfully restored: #{path}"

      # 3. 백업 파일 삭제 (선택적)
      # Optionally, remove the backup after a successful restore
      FileUtils.rm_f(backup_path)
      puts "    [DEBUG] Removed backup: #{backup_path}".cyan
      debug_log "Removed backup file after restore"
    rescue => e
      puts "    [ERROR] Restore failed: #{e}".red
      debug_log "Exception while restoring: #{e.class} - #{e.message}"

      # 4. 복구 시도: 임시 파일 → 원본
      # On failure, try reverting from temp file
      if File.exist?(temp_path)
        FileUtils.mv(temp_path, path)
        puts "    [INFO] Recovered original state".cyan
        debug_log "Rolled back to temp file after failed restore"
      end

      exit(1)
    end
  end

  def self.belongs_to_active_target?(path, active_target_name, project_dir)
    norm_path   = File.expand_path(path)
    target_root = File.join(project_dir, active_target_name) + "/"
    norm_path.start_with?(target_root)
  end

  def self.traverse_group(group, indent=0, sources=[])
    return if group.nil?
    if group.respond_to?(:children) && group.children.is_a?(Array)
      group.children.each do |child|
        begin
          traverse_group(child, indent+1, sources)
        rescue
          # silently skip on error
        end
      end
    end
    if group.is_a?(Xcodeproj::Project::Object::PBXFileSystemSynchronizedRootGroup)
      real_path = File.join(File.dirname(group.project.path), group.path || "")
      if Dir.exist?(real_path)
        Dir.entries(real_path).each do |entry|
          next if entry == "." || entry == ".."
          full_path = File.join(real_path, entry)
          if File.directory?(full_path)
            traverse_folder_reference(full_path, indent+2, sources)
          elsif entry =~ /\.(swift|m|mm|c|cpp)$/
            sources << full_path unless sources.include?(full_path)
          end
        end
      end
    end
    if group.respond_to?(:files) && group.files.is_a?(Array)
      group.files.each do |file_ref|
        next if file_ref.nil?
        path = file_ref.path || ""
        if path =~ /\.(swift|m|mm|c|cpp)$/
          abs_path = File.join(File.dirname(group.project.path), path)
          sources << abs_path unless sources.include?(abs_path)
        end
      end
    end
    sources
  end

  def self.traverse_folder_reference(folder_path, indent=0, sources=[])
    Dir.entries(folder_path).each do |entry|
      next if entry == "." || entry == ".."
      full_path = File.join(folder_path, entry)
      if File.directory?(full_path)
        traverse_folder_reference(full_path, indent+1, sources)
      elsif entry =~ /\.(swift|m|mm|c|cpp)$/
        sources << full_path unless sources.include?(full_path)
      end
    end
  end


  # High-level entry point used by CLI (apply / restore).
  # - project_path: root path of the Xcode project
  # - action: "apply" or "restore"
  def self.string_encryption_main(project_path:, action:)
    require "xcodeproj"
    require "fileutils"

    # Initialize global state as used by legacy logic
    $request_param = []
    $source_path   = []
    $enc_strings   = {}
    $action        = action

    # 1. Resolve project path
    if project_path.nil? || project_path.empty? || !File.exist?(project_path)
      project_path = File.dirname(File.dirname(__dir__))
      puts "    [INFO] Auto-set project path to: #{project_path}".cyan
    end
    unless File.exist?(project_path)
      puts "    [ERROR] Invalid project path: #{project_path}".red
      exit(1)
    end

    # 2. Open Xcode project and target selection
    root_xcodeproj = Dir[File.join(project_path, "*.xcodeproj")]
    if !root_xcodeproj.nil? && !root_xcodeproj.empty?
      xcodeproj = root_xcodeproj
      puts "    [INFO] Found Xcode project in root: #{xcodeproj[0]}".cyan
    else
      all_xcodeproj = Dir[File.join(project_path, "**", "*.xcodeproj")]
      if !all_xcodeproj.nil? && !all_xcodeproj.empty?
        xcodeproj = all_xcodeproj
        puts "    [INFO] Found Xcode project in subdirectory: #{xcodeproj[0]}".cyan
      else
        puts "    [ERROR] Cannot find Xcode project file in: #{project_path}".red
        exit(1)
      end
    end

    Encoding.default_external = Encoding::UTF_8
    Encoding.default_internal = Encoding::UTF_8
    begin
      puts "    [INFO] Opening Xcode project: #{xcodeproj[0]}".cyan
      project = Xcodeproj::Project.open(xcodeproj[0])
    rescue => e
      puts "    [ERROR] Can't open project: #{e}".red
      exit(1)
    end

    if project.targets.empty?
      puts "    [ERROR] No target in Xcode project: #{xcodeproj[0]}".red
      exit(1)
    end

    target = project.targets.first
    if target.nil? || target == ""
      puts "    [ERROR] Target name is empty: #{xcodeproj[0]}".red
      exit(1)
    end

    puts "    [INFO] Processing target: #{target}".cyan

    # 3. Check AppSealing SDK files
    unless File.exist?(File.join(project_path, "AppSealingSDK", "Libraries", "appsealing.lic"))
      puts "    [ERROR] Cannot find AppSealing license file. Check AppSealing SDK files: #{project_path}".red
      exit(1)
    end
    unless File.exist?(File.join(project_path, "AppSealingSDK", "Libraries", "AppsealingiOS.mm"))
      puts "    [ERROR] Cannot find AppsealingiOS.mm interface file. Check AppSealing SDK files: #{project_path}".red
      exit(1)
    end

    # 4. Extract bundle ID
    $bundle_id = target.build_configurations.first.build_settings["PRODUCT_BUNDLE_IDENTIFIER"]
    if $bundle_id.nil? || $bundle_id.empty?
      puts "    [ERROR] Cannot extract bundle ID from: #{target}".red
      exit(1)
    end
    puts "    [INFO] Bundle ID: #{$bundle_id}".cyan

    # 5. Collect source files
    project_dir        = File.dirname(project.path)
    active_target_name = target.name

    main_group_sources = traverse_group(project.main_group, 1, [])
    main_group_sources = main_group_sources.select do |p|
      belongs_to_active_target?(p, active_target_name, project_dir)
    end

    target_sources = []
    if target.respond_to?(:source_build_phase)
      begin
        target.source_build_phase.files.each do |bf|
          next if bf.file_ref.nil?
          file_path = bf.file_ref.real_path.to_s
          if belongs_to_active_target?(file_path, active_target_name, project_dir)
            target_sources << file_path
          end
        end
      rescue
        # ignore errors while collecting build phase files
      end
    end

    lea_section_path = File.join(project_path, "AppSealingSDK", "Libraries", "LEASection.mm")
    if File.exist?(lea_section_path)
      target_sources << lea_section_path unless target_sources.include?(lea_section_path)
    end

    sources = (main_group_sources + target_sources).compact.uniq
    if sources.empty?
      puts "[ERROR] No valid source files found for active target!"
      exit(1)
    end

    # 6. Scan sources and collect tagged strings
    sources.each do |path|
      unless File.exist?(path)
        puts "    [WARN] Source file does not exist: #{path}".yellow
        next
      end

      if action == "restore"
        $source_path << path
        puts "    [INFO] Added to restore list: #{path}".cyan
        next
      end

      begin
        strings = extract_tagged_strings(path)
      rescue => e
        puts "    [WARN] Failed to extract tagged strings from #{path}: #{e}".yellow
        next
      end

      if strings.empty?
        puts "    [INFO] No tagged strings found in: #{path}".cyan
        next
      end

      puts "    [INFO] Found #{strings.size} tagged strings in: #{path}"
      strings.each { |s| $request_param << s }
      $source_path << path
    end

    # 7. Encrypt strings via server/local AES
    if action != "restore" && $request_param.length > 0
      begin
        puts "    [INFO] Encrypting #{$request_param.length} strings...".cyan
        $enc_strings = get_encrypted_strings(project_path, $request_param)
        puts "    [INFO] Encrypted strings ready.".cyan
      rescue => e
        puts "    [ERROR] String encryption failed: #{e}".red
        exit(1)
      end
    end

    # 8. Backup and replace/restore
    $source_path.each do |file|
      unless File.exist?(file)
        puts "    [WARN] Source file not found for replace/restore: #{file}".yellow
        next
      end

      if action == "restore"
        begin
          puts "    [INFO] Restoring original code: #{file}".cyan
          restore_original_code(file)
        rescue => e
          puts "    [ERROR] Restore failed for #{file}: #{e}".red
        end
      else
        begin
          backup_file = "#{file}.org"
          FileUtils.cp(file, backup_file)
          puts "    [INFO] Backup created: #{backup_file}".cyan
          replace_tagged_strings(file)
          puts "    [INFO] Replaced tagged strings in: #{file}".cyan
        rescue => e
          puts "    [ERROR] Replace failed for #{file}: #{e}".red
        end
      end
    end

    puts "    [INFO] String encryption process completed.".cyan
  end
 
