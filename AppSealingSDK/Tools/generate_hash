# Rebuilds a modified app bundle into an IPA, cleans up temp files, and verifies the final package.
#--------------------------------------------------------------------------------------------
class IpaRebuilder

  def self.rebuild_and_cleanup(argv, folder, app_path)
    puts "\n[STEP #{$current_step += 1}] Rebuilding & Re-signing IPA".bold.yellow
    debug_log "Beginning IPA re-packaging and final export..." if defined?(debug_log)

    original_ipa = File.absolute_path(argv[0])
    resigned_ipa = File.join(
      File.dirname(original_ipa),
      "#{File.basename(original_ipa, File.extname(original_ipa))}.ipa"
    )
    puts "  • Output IPA: #{resigned_ipa}"
    debug_log "Output IPA path set: #{resigned_ipa}" if defined?(debug_log)

    if File.exist?(resigned_ipa)
      puts "    [INFO] Removing existing IPA: #{resigned_ipa}".cyan
      FileUtils.rm(resigned_ipa, force: true)
      debug_log "Old IPA deleted: #{resigned_ipa}" if defined?(debug_log)
    end

    package_dir = File.join(folder, "Package")
    puts "    [INFO] Packaging from: #{package_dir}".cyan
    debug_log "Packaging directory: #{package_dir}" if defined?(debug_log)

    zip_command = [
      "cd #{Shellwords.escape(package_dir)}",
      "zip -qr #{Shellwords.escape(resigned_ipa)} ./*",
    ].join(" && ")

    unless system(zip_command)
      raise "IPA packaging failed (exit #{$?.exitstatus})"
    end

    puts "    [SUCCESS] ZIP command executed successfully".green
    debug_log "IPA packaged successfully at: #{resigned_ipa}" if defined?(debug_log)

    unless File.exist?(resigned_ipa)
      raise "Resigned IPA not created: #{resigned_ipa}"
    end

    final_size = File.size(resigned_ipa)
    puts "    [SUCCESS] IPA created: #{final_size} bytes".green
    debug_log "Final IPA size: #{final_size} bytes" if defined?(debug_log)

    puts "    [INFO] Cleaning temporary files".cyan
    FileUtils.remove_entry_secure(folder, force: true)
    puts "    [DEBUG] Temp directory removed: #{folder}".yellow
    debug_log "Temp folder removed: #{folder}" if defined?(debug_log)

    puts "\n\n[END] All processes have done successfully .......\n\n\n".bold.green
    debug_log "IPA generation process completed successfully" if defined?(debug_log)
  rescue => e
    puts <<~ERROR.red.bold
           [CRITICAL ERROR] IPA rebuild failed
           Step: #{current_step}
           Message: #{e.message}
           Backtrace:
           #{e.backtrace.first(5).join("\n")}
         ERROR
    debug_log "IPA rebuild exception: #{e.class} - #{e.message}" if defined?(debug_log)
    exit(false)
  end
end


