#--------------------------------------------------------------------------------------------
# AssetsScanner 클래스는 앱 번들 내 모든 Assets.car 파일을 안전하게 찾아 문자열로 조합합니다.
# Scans recursively inside the app bundle for Assets.car files, safely and case-insensitively.
#--------------------------------------------------------------------------------------------
class AssetsScanner
  def self.scan_assets_car(app_path)
    assets = ""
    assets_pattern = File.join(app_path, "**", "Assets.car")
    files = Dir.glob(assets_pattern, File::FNM_CASEFOLD).select { |path| File.file?(path) }

    if files.empty?
      puts "[WARNING] No Assets.car files found".yellow
      debug_log "No Assets.car files found in: #{app_path}" if defined?(debug_log)
    else
      files.each do |car|
        relative_path = car.sub(/#{Regexp.escape(File.join(app_path, ""))}/, "")
        assets += "#{relative_path}\u0002"
        puts "    [DEBUG] Found Assets.car: #{relative_path}".yellow
        debug_log "Found Assets.car: #{relative_path}" if defined?(debug_log)
      end
      assets.chomp!("\u0002")
      debug_log "Assets.car string assembled: #{assets}" if defined?(debug_log)
    end

    assets
  end
end

