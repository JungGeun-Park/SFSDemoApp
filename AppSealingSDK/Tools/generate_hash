#
#    Swift / Objective-C Code syntax parser / checker for Secure Filesystem
#
#    - this check logic is activated when securefile option is enabled
#    - Swift code is checked by ScanSwiftAST external tool (git checkout & compile)
#    - Objective-C code is checked by Clang-AST external tool
