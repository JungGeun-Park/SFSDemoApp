#--------------------------------------------------------------------------------------------
#    SwiftSyntax main.swift content (AST dumper)
#--------------------------------------------------------------------------------------------

MAIN_SWIFT_CONTENT = <<~MAIN
    import Foundation
    import SwiftSyntax
    import SwiftParser

    struct Finding: Codable {
        let kind: String      // "member" or "declRef"
        let base: String      // base expression for member calls
        let name: String      // method/function base name
        let full: String      // calledExpression text
        let line: Int
        let code: String
        let arg0: String      // first argument expression text (empty if none)
        let argLabels: [String] // argument labels in call site order
    }

    guard CommandLine.arguments.count > 1 else {
        fputs("[ERROR] No Swift file provided.\\n", stderr)
        exit(1)
    }

    let filePath = CommandLine.arguments[1]
    let fileURL = URL(fileURLWithPath: filePath)
    var findings: [Finding] = []

    do {
        let sourceText = try String(contentsOf: fileURL)
        let sourceFile = Parser.parse(source: sourceText)
        let converter = SourceLocationConverter(fileName: filePath, tree: sourceFile)

        final class FunctionCallVisitor: SyntaxVisitor {
            var findings: [Finding] = []
            let converter: SourceLocationConverter

            init(converter: SourceLocationConverter) {
                self.converter = converter
                super.init(viewMode: .sourceAccurate)
            }

            override func visit(_ node: FunctionCallExprSyntax) -> SyntaxVisitorContinueKind {
                let called = node.calledExpression
                let location = converter.location(for: node.positionAfterSkippingLeadingTrivia)
                let lineNumber = location.line
                let code = node.description.trimmingCharacters(in: .whitespacesAndNewlines)

                let arg0Expr = node.arguments.first?.expression
                let arg0Text = arg0Expr?.description.trimmingCharacters(in: .whitespacesAndNewlines) ?? ""

                // collect argument labels (nil → "_")
                let labels: [String] = node.arguments.map { arg in
                    arg.label?.text ?? "_"
                }

                // member call: base.member(...)
                if let member = called.as(MemberAccessExprSyntax.self) {
                    let base = (member.base?.description ?? "").trimmingCharacters(in: .whitespacesAndNewlines)
                    let name = member.declName.baseName.text
                    findings.append(
                        Finding(
                            kind: "member",
                            base: base,
                            name: name,
                            full: member.description.trimmingCharacters(in: .whitespacesAndNewlines),
                            line: lineNumber,
                            code: code,
                            arg0: arg0Text,
                            argLabels: labels
                        )
                    )
                    return .skipChildren
                }

                // type or function call: TypeName(...), funcName(...)
                if let declRef = called.as(DeclReferenceExprSyntax.self) {
                    let name = declRef.baseName.text
                    findings.append(
                        Finding(
                            kind: "declRef",
                            base: "",
                            name: name,
                            full: declRef.description.trimmingCharacters(in: .whitespacesAndNewlines),
                            line: lineNumber,
                            code: code,
                            arg0: arg0Text,
                            argLabels: labels
                        )
                    )
                    return .skipChildren
                }

                // fallback
                findings.append(
                    Finding(
                        kind: "other",
                        base: "",
                        name: "",
                        full: called.description.trimmingCharacters(in: .whitespacesAndNewlines),
                        line: lineNumber,
                        code: code,
                        arg0: arg0Text,
                        argLabels: labels
                    )
                )
                return .skipChildren
            }
        }

        let visitor = FunctionCallVisitor(converter: converter)
        visitor.walk(sourceFile)
        findings = visitor.findings

        let encoder = JSONEncoder()
        encoder.outputFormatting = [.prettyPrinted]
        let jsonData = try encoder.encode(findings)
        print(String(data: jsonData, encoding: .utf8)!)
    } catch {
        fputs("[ERROR] Failed to parse Swift file: \(error)\\n", stderr)
        exit(1)
    }
MAIN

