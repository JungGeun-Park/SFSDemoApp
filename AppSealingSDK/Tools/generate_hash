require "json"
require "pathname"
require "fileutils"
require "find"

class HermesValidator

    ################################################################################################
    #
    # React Native version detection
    #
    ################################################################################################

    def self.detect_react_native_version_from_project_root
        current_dir  = Pathname.new(__dir__)
        project_root = current_dir.join("../..").expand_path

        version = nil
        puts "    [INFO] Searching React Native version in project : #{project_root}".cyan

        # 1) package.json
        pkg = project_root.join("package.json")
        if pkg.exist?
            begin
                json = JSON.parse(File.read(pkg))
                if json["dependencies"] && json["dependencies"]["react-native"]
                    version = json["dependencies"]["react-native"].gsub(/[^0-9.]/, "")
                    puts "    [INFO] Found in package.json: #{version}".cyan
                end
            rescue => e
                puts "    [WARN] package.json parse failed: #{e.message}".yellow
            end
        end

        # 2) node_modules fallback
        unless version
            rn_pkg = project_root.join("node_modules/react-native/package.json")
            if rn_pkg.exist?
                begin
                    json = JSON.parse(File.read(rn_pkg))
                    version = json["version"]
                    puts "    [INFO] Found in node_modules: #{version}".cyan
                rescue => e
                    puts "    [WARN] react-native/package.json parse failed: #{e.message}".yellow
                end
            end
        end

        unless version
            puts "    [ERROR] React Native version not detected!".red
        end

        version
    end

    ################################################################################################
    #
    # RN helpers
    #
    ################################################################################################

    def self.parse_rn_version(rn_version)
        parts       = rn_version.split(".")
        major_minor = parts[0..1].join(".")
        patch       = parts[2]&.to_i
        [major_minor, patch]
    end

    def self.hermes_engine_name_for_rn(rn_version)
        major_minor, _ = parse_rn_version(rn_version)
        major_minor.to_f >= 0.82 ? "hermesvm" : "hermes"
    end

    ################################################################################################
    #
    # Hermes ↔ RN compatibility matrix (AppSealing)
    #
    ################################################################################################

    HERMES_RN_MATRIX = {
        "85613e1f9d1216f2cce7e54604be46057092939d" => [["0.71"]],
        "49794cfc7c81fb8f69fd60c3bbf85a7480cc5a77" => [["0.72"]],
        "21043a3fc062be445e56a2c10ecd8be028dd9cc5" => [["0.73"]],
        "bb1e74fe1e95c2b5a2f4f9311152da052badc2bc" => [["0.74", 0..2]],
        "7bda0c267e76d11b68a585f84cfdd65000babf85" => [["0.74", 3..6], ["0.75"]],
        "db6d12e202e15f7a446d8848d6ca8f7abb3cfb32" => [["0.76"], ["0.77", 0..1]],
        "a942ef374897d85da38e9c8904574f8376555388" => [["0.78"]],
        "4eb6132a5bf0450bf4c6c91987675381d7ac8bca" => [["0.79"], ["0.80"]],
        "e0fc67142ec0763c6b6153ca2bf96df815539782" => [["0.81"], ["0.82"], ["0.83"]],
    }

    def self.version_match?(rn_version, _hermes_rn_range, hermes_commit)
        rn_major_minor, rn_patch = parse_rn_version(rn_version)
        matrix = HERMES_RN_MATRIX[hermes_commit]
        return false unless matrix

        matrix.any? do |ver|
            if ver.length == 1
                rn_major_minor == ver[0]
            else
                rn_major_minor == ver[0] && rn_patch && ver[1].include?(rn_patch)
            end
        end
    end

    ################################################################################################
    #
    # Binary metadata extraction
    #
    ################################################################################################

    APPSEALING_VERSION_PATTERN = /AppSealing Starter (\d+\.\d+\.\d+\.\d+)/
    HERMES_COMMIT_PATTERN =
        /\[AppSealing\] hermes engine: ([a-fA-F0-9]+) \(for React Native ([\d]+(?:\.[\dx]+)*(?: ~ [\d]+(?:\.[\dx]+)*)?)\)/i

    def self.extract_appsealing_version_from_file(path)
        File.binread(path) =~ APPSEALING_VERSION_PATTERN ? $1 : nil
    rescue => e
        puts "    [ERROR] Failed to read #{path}: #{e.message}".red
        nil
    end

    def self.extract_hermes_commit_and_rn_version(path)
        File.binread(path) =~ HERMES_COMMIT_PATTERN ? [$1, $2] : [nil, nil]
    rescue => e
        puts "    [ERROR] Failed to read #{path}: #{e.message}".red
        [nil, nil]
    end

    ################################################################################################
    #
    # Hermes / HermesVM file search
    #
    ################################################################################################

    def self.find_hermes_engine_files(dir, engine_name)
        results = []

        unless dir && File.directory?(dir)
            puts "    [ERROR] Directory does not exist: #{dir}".red
            return results
        end

        Find.find(dir) do |path|
            next unless File.file?(path)
            if File.basename(path).downcase == engine_name
                results << path
                puts "    [FOUND] #{path}".green
            end
        end

        results
    end

    ################################################################################################
    #
    # Main validation + replacement logic
    #
    ################################################################################################

    def self.check_and_copy_hermes_files(project_rn_version, script_dir, app_path)
        engine_name = hermes_engine_name_for_rn(project_rn_version)

        puts "\n    [INFO] React Native #{project_rn_version} → engine: #{engine_name}".cyan

        # --------------------------------------------------------------------------------------------
        # Project side
        # --------------------------------------------------------------------------------------------
        project_engines = find_hermes_engine_files(script_dir, engine_name)
        if project_engines.empty?
            puts "    [ERROR] Project #{engine_name} not found.".red
            return false
        end

        project_appsealing_version =
            extract_appsealing_version_from_file(project_engines[0])
        project_commit, project_rn_range =
            extract_hermes_commit_and_rn_version(project_engines[0])

        unless version_match?(project_rn_version, project_rn_range, project_commit)
            puts "    [ERROR] Project #{engine_name} incompatible with RN #{project_rn_version}".red
            return false
        end

        # --------------------------------------------------------------------------------------------
        # IPA side
        # --------------------------------------------------------------------------------------------
        puts "\n    [INFO] Searching #{engine_name} in IPA...".cyan
        app_engines = find_hermes_engine_files(app_path, engine_name)
        if app_engines.empty?
            puts "    [ERROR] IPA #{engine_name} not found.".red
            return false
        end

        app_appsealing_version =
            extract_appsealing_version_from_file(app_engines[0])
        app_commit, app_rn_range =
            extract_hermes_commit_and_rn_version(app_engines[0])

        if app_commit.nil? || app_commit.empty?
            puts "    [WARN] IPA #{engine_name} hermes version not detectable".yellow
            puts "    [ACTION] Will replace IPA #{engine_name} with project #{engine_name}".yellow
        else
            unless version_match?(project_rn_version, app_rn_range, app_commit)
                puts "    [ERROR] IPA #{engine_name} incompatible with RN #{project_rn_version}".red
                return false
            end
        end

        puts "\n    [Project] AppSealing #{project_appsealing_version}, Commit #{project_commit}".yellow
        puts "    [IPA]     AppSealing #{app_appsealing_version}, Commit #{app_commit}".yellow

        # --------------------------------------------------------------------------------------------
        # Replacement
        # --------------------------------------------------------------------------------------------
        return true if project_appsealing_version == app_appsealing_version

        puts "    [ACTION] Replacing IPA #{engine_name} with project #{engine_name}".white

        app_engines.each do |dest|
            FileUtils.cp(project_engines[0], dest)
            puts "    [COPY] #{dest}"
        end

        puts "    [SUCCESS] #{engine_name} replacement completed.".green
        true
    end
end

# hash_lib/code_signer.rb

require "fileutils"
require "open3"

#--------------------------------------------------------------------------------------------
#  CodeSigner 클래스는 앱 번들에 대한 인증서 추출, 엔타이틀먼트 처리, 재서명 기능을 제공합니다.
#  This class handles extracting certificates, entitlements, and re-signing app bundles.
#--------------------------------------------------------------------------------------------
class CodeSigner
  def self.sign_app_payload(_app, _folder, generate_info_only)
      cert_sha1 = ''
      app    = File.expand_path(_app)
      folder = File.expand_path(_folder) + "/"

      begin
          # 0. Pre-checks: make sure the app bundle and working folder exist
          puts "    [INFO] Verifying directory structure...".cyan
          raise "Directory does not exist (#{folder})" unless Dir.exist?(folder)
          raise "App path does not exist (#{app})"      unless Dir.exist?(app)
          puts "    [SUCCESS] Directory validation passed".green

          # 1. Extract code signing certificates from the app bundle into the working folder
          puts "    [INFO] Extracting code signing certificates...".cyan
          Dir.chdir(folder) do
              unless system('codesign', '-d', '--extract-certificates', app, out: :close, err: :close)
                  raise "Failed to extract app certificates"
              end
          end
          puts "    [SUCCESS] Certificates extracted".green

          if generate_info_only
              # 2. Extract embedded provisioning profile as a plist for inspection
              puts "    [INFO] Processing mobileprovision...".cyan
              profile_path = File.join(app, 'embedded.mobileprovision')
              output_plist = File.join(folder, 'provision.plist')
              unless system('security', 'cms', '-D', '-i', profile_path, out: output_plist, err: :close)
                  raise "Failed to extract provisioning profile"
              end
              puts "    [SUCCESS] Provisioning profile extracted".green

              # 3. Prepare entitlements file:
              #    - Use a user-provided entitlements file if $Entitlements is set.
              #    - Otherwise, extract entitlements from the existing app signature.
              entitlements_path = File.join(folder, 'entitlements.plist')
              puts "    [INFO] Generating entitlements...".cyan
              if defined?($Entitlements) && !$Entitlements.to_s.strip.empty?
                  FileUtils.cp($Entitlements, entitlements_path)
                  puts "    [INFO] Using custom entitlements file".cyan
              else
                  unless system('codesign', '-d', '--entitlements', '-', '--xml', app,
                                out: entitlements_path, err: :close)
                      raise "Failed to extract entitlements"
                  end
                  puts "    [INFO] Extracted entitlements from app".cyan
              end

              # 4. Process all extracted certificates:
              #    - Convert DER to human-readable text (subject/issuer/serial/dates/etc).
              #    - Extract PEM-formatted public key information for debugging/verification.
              puts "    [INFO] Generating certificate details...".cyan
              %w[0 1 2].each do |i|
                  cert_der = File.join(folder, "codesign#{i}")
                  cert_txt = File.join(folder, "certificate#{i}.txt")
                  pem_txt  = File.join(folder, "pemformat#{i}.txt")

                  raise "Missing DER certificate: #{cert_der}" unless File.exist?(cert_der)

                  unless system(
                      'openssl', 'x509',
                      '-inform', 'DER',
                      '-in',     cert_der,
                      '-noout',
                      '-nameopt', 'multiline,utf8',
                      '-subject', '-issuer', '-serial',
                      '-pubkey',  '-text',   '-dates',
                      '-certopt',
                      'no_header,no_version,no_serial,no_signame,no_subject,' \
                      'no_issuer,no_validity,no_pubkey,no_sigdump,no_aux,no_extensions',
                      out: cert_txt,
                      err: :close
                  )
                      raise "Failed to generate certificate details: #{cert_der}"
                  end

                  unless system(
                      'openssl', 'rsa',
                      '-pubin',
                      '-inform', 'PEM',
                      '-text',
                      '-noout',
                      in:  cert_txt,
                      out: pem_txt,
                      err: :close
                  )
                      raise "Failed to convert to PEM format: #{cert_txt}"
                  end

                  puts "    [DEBUG] Processed certificate #{i} → #{pem_txt}".yellow
              end

              # When generate_info_only is true, we stop here after producing
              # provisioning / entitlements / certificate info.
              return
          end

          # 5. Convert the leaf (first) certificate from DER to PEM for SHA-1 extraction
          puts "    [INFO] Processing leaf certificate...".cyan
          cert_der = File.join(folder, "codesign0")
          cert_pem = File.join(folder, "certificate.pem")
          raise "Missing leaf certificate: #{cert_der}" unless File.exist?(cert_der)

          unless system('openssl', 'x509', '-inform', 'DER', '-in', cert_der, '-out', cert_pem)
              raise "Leaf certificate conversion failed"
          end
          puts "    [SUCCESS] Leaf certificate converted".green

          # 6. Extract SHA-1 fingerprint from the leaf certificate (case-insensitive regex)
          puts "    [INFO] Extracting certificate SHA-1 fingerprint...".cyan
          sha1_result = `openssl x509 -in #{cert_pem} -noout -fingerprint -sha1`

          # Support both "SHA1 Fingerprint=" and case variants like "sha1 Fingerprint="
          cert_sha1 = sha1_result.scan(/SHA1 Fingerprint=(.*)/i).flatten.first.to_s.gsub(/[:\s]/, "")

          if cert_sha1.empty?
              puts ".\n.\n[ERROR] Certificate SHA1 fingerprint missing - verify IPA integrity\n.\n.".red.bold
              exit(false)
          end
          puts "  • Using certificate SHA-1: #{cert_sha1}"

          # 7. Ensure the certificate fingerprint actually exists in the current keychain
          puts "    [INFO] Validating against keychain...".cyan
          keychain_output, status = Open3.capture2('security', 'find-identity', '-v', '-p', 'codesigning')
          unless status.success?
              puts "    [ERROR] Keychain query failed".red
              puts keychain_output.lines.map { |l| "    #{l}" }.join
              raise "Keychain validation error"
          end

          # Collect all 40-hex-digit fingerprints and compare case-insensitively
          fingerprint_matches =
              keychain_output
                  .scan(/([A-F0-9]{40})/i)
                  .map(&:first)
                  .select { |fp| fp.casecmp(cert_sha1).zero? }

          if fingerprint_matches.size > 1
              puts ".\n.\n[CRITICAL] AMBIGUOUS CERTIFICATE ERROR".red.bold
              puts "Found multiple matching SHA-1 fingerprints for: #{cert_sha1}".red
              puts "Possible solutions:".yellow
              puts "  1. Remove duplicate certificates from Keychain Access".yellow
              puts "  2. Use explicit SHA-1 fingerprint for selection".yellow
              puts "  3. Contact your certificate administrator".yellow
              puts "Keychain output:\n#{keychain_output}".red
              exit(false)
          end

          unless fingerprint_matches.size == 1
              puts "    [WARNING] Certificate SHA-1 not found in keychain".yellow
              puts "    [DEBUG] Available certificates:".yellow
              system('security', 'find-identity', '-v', '-p', 'codesigning')
              raise "Certificate SHA1 mismatch"
          end
          puts "    [SUCCESS] Keychain validation passed".green

          # 8. Re-sign Hermes frameworks (RN 0.82+ safe detection)
          frameworks_dir = File.join(app, "Frameworks")

          if Dir.exist?(frameworks_dir)
            puts "    [INFO] Detecting Hermes frameworks (strict)...".cyan

            hermes_frameworks = Dir.glob(File.join(frameworks_dir, "*.framework")).select do |fw|
                exec_name = File.basename(fw, ".framework")
                exec_path = File.join(fw, exec_name)

                next false unless File.exist?(exec_path)
                next false unless exec_name =~ /\Ahermes(vm)?\z/i

                true
            end
            if hermes_frameworks.empty?
                puts "    [INFO] No Hermes frameworks detected".yellow
            end

            hermes_frameworks.each do |fw|
                puts "    [INFO] Re-signing Hermes framework: #{File.basename(fw)}".cyan

                codesig_dir = File.join(fw, "_CodeSignature")
                FileUtils.rm_rf(codesig_dir) if File.exist?(codesig_dir)

                unless system(
                    'codesign',
                    '-f',
                    '-s', cert_sha1,
                    '--preserve-metadata=identifier,entitlements,flags',
                    fw,
                    out: :close,
                    err: :close
                )
                    raise "Failed to code-sign Hermes framework: #{fw}"
                end

                puts "    [SUCCESS] Signed #{File.basename(fw)}".green
            end
          end

          # 9. Perform final code signing on the app bundle with entitlements
          puts "    [INFO] Starting code signing...".cyan
          codesig_dir       = File.join(app, "_CodeSignature")
          FileUtils.rm_rf(codesig_dir) if File.exist?(codesig_dir)

          entitlements_path = File.join(folder, "entitlements.plist")
          raise "Missing entitlements file: #{entitlements_path}" unless File.exist?(entitlements_path)

          unless system('codesign', '-f', '-s', cert_sha1, '--entitlements', entitlements_path,
                        app, out: :close, err: :close)
              raise "Code signing failed"
          end
          puts "    [SUCCESS] Code signing completed".green

      rescue SystemExit
          # Re-raise explicit exits (used above when we already printed a detailed message)
          raise
      rescue => e
          # Catch-all for unexpected failures during signing pipeline
          puts ".\n.\n[CRITICAL] Code signing error: #{e}\n" \
              "Please verify inputs and environment.\n" \
              "For persistent issues, contact AppSealing support.\n.\n.\n"
          exit(false)
      end
  end
end
# hash_lib/snapshot_builder.rb

#--------------------------------------------------------------------------------------------
# SnapshotBuilder 클래스는 인증서 정보와 CodeResources 해시를 결합해 무결성 스냅샷을 만듭니다.
# Combines certificate info and CodeResources file hashes into a snapshot string
#--------------------------------------------------------------------------------------------
class SnapshotBuilder
  def self.generate_snapshot(certificate, code_resources_path)
    snapshot = certificate + generate_hash_snapshot(code_resources_path)
    debug_log "Snapshot assembled. Total size: #{snapshot.bytesize} bytes" if defined?(debug_log)
    snapshot
  end

  #--------------------------------------------------------------------------------------------
  #  _CodeSignature/CodeResources 파일을 읽어 <key>files</key> 항목의 모든 데이터를 문자열로 변환하여 리턴
  #  Read the _CodeSignature/CodeResources file and return all <key>files</key> data items as a single string
  #--------------------------------------------------------------------------------------------
  # Parses XML in a CodeResources file, extracting all file keys and their hash values from the <key>files</key> dictionary.
  # - Ignores the <key>files2</key> section if present.
  # - Concatenates each "key\x01hash" line with a newline.
  # - Returns this "snapshot" string for file fingerprinting or verification.
  def self.generate_hash_snapshot(path)
    debug_log "generate_hash_snapshot called with path=#{path}"
    snapshot = ""
    key = ""
    expect_data = false
    in_dict = false
    in_hash = false
    in_data = false
    hash_value = nil
    line_no = 0

    begin
      debug_log "Opening file: #{path}"
      file = File.open(path)
      file.each_line do |line|
        line_no += 1
        sline = line.strip

        # <key>files2</key> 진입 시 중단 ("files2"가 나오면 끝)
        # If <key>files2</key> key is found, exit loop — we only want original files block
        break if sline.start_with?("<key>files2</key>")

        # <key>files</key> 키는 건너뜀
        # Skip the <key>files</key> marker line; actual dict parsing begins after
        next if sline.start_with?("<key>files</key>")

        # key 추출
        # Extract file key name
        if !expect_data && sline.start_with?("<key>") && sline.end_with?("</key>")
          key = sline.gsub("<key>", "").gsub("</key>", "")
          debug_log "Found file key: #{key}" if $debug_mode
          expect_data = true
          next
        end

        # dict 내부 진입
        # Entering a <dict> containing hash/data for this file
        if sline == "<dict>" && expect_data
          in_dict = true
          debug_log "Entering <dict> block for key: #{key}"
          next
        end

        # dict 내부에서 hash/data 추출
        # Inside dict, retrieve <hash>/<data> block for file hash
        if in_dict
          if sline == "<key>hash</key>"
            in_hash = true
            next
          elsif in_hash && sline == "<data>"
            in_data = true
            hash_value = ""
            debug_log "Inside <data> for key: #{key}"
            next
          elsif in_data
            if sline == "</data>"
              in_data = false
              in_hash = false
              snapshot += "#{key}\1#{hash_value.strip}\n"
              debug_log "Extracted hash for #{key}: #{hash_value.strip[0..20]}..." if $debug_mode
            else
              hash_value += sline
            end
            next
          elsif sline == "</dict>"
            in_dict = false
            expect_data = false  # ★ dict 끝에서 expect_data를 반드시 false로!
            debug_log "Leaving <dict> block for key: #{key}"
            next
          end
        end

        # 기존 <data> (dict 아닌 경우)
        # Older data pattern: grab <data> when not inside a dict (shouldn't be required in modern files, but guard for legacy)
        if sline == "<data>" && expect_data && !in_dict
          in_data = true
          hash_value = ""
          debug_log "Legacy <data> start for key: #{key} (outside <dict>)"
          next
        end
        if in_data && !in_dict
          if sline == "</data>"
            snapshot += "#{key}\1#{hash_value.strip}\n"
            debug_log "Legacy hash for #{key}: #{hash_value.strip[0..20]}..." if $debug_mode
            in_data = false
            expect_data = false
          else
            hash_value += sline
          end
          next
        end
      end
    rescue => e
      # 예외처리: 잘못된 경로나 파일 등
      # Exception handling: invalid IPA/resource file, missing or corrupt
      puts ".\n.\nInvalid IPA file has passed to an argument, check your IPA file and try again.\n.\n.\n"
