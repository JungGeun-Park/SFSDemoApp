#--------------------------------------------------------------------------------------------
# JSBundleEncryptor 클래스는 main.jsbundle 파일을 서버에 보내 암호화 처리하고 결과물을 받아 옵니다.
# Sends and encrypts the React Native main.jsbundle using the AppSealing server API.
#--------------------------------------------------------------------------------------------
class JSBundleEncryptor

  def self.debug_log(message)
    puts "[DEBUG] #{message}" if ENV["DEBUG"] == "true"
  end

  def self.encrypt_javascript_bytecode(app, bundle_id)
    debug_log "encrypt_javascript_bytecode started for app=#{app}"

    $sdk_version = "1.0.0.0" if $sdk_version.start_with?("NEW")
    $use_ssl = !$baseURL.start_with?("http://")
    debug_log "Using SDK version: #{$sdk_version}, use_ssl: #{$use_ssl}"

    zip_path    = "#{app}/main.zip"
    result_path = "#{app}/enc_main.zip"
    debug_log "Preparing temp files: zip_path=#{zip_path}, result_path=#{result_path}"

    begin
      debug_log "Archiving main.jsbundle to #{zip_path}"
      unless system("cd #{Shellwords.escape(app)} && zip -q main.zip main.jsbundle")
        debug_log "Zip archive creation failed"
        raise "Failed to create JS bundle archive"
      end
      puts "    [INFO] Temporary archive created: #{zip_path}".cyan

      endpoints = {
        sealing:  URI("#{$baseURL}html5/requestSealingForIOS"),
        status:   URI("#{$baseURL}html5/sealingStatusForIOS"),
        download: URI("#{$baseURL}html5/downloadSealedFileForIOS"),
      }
      debug_log "Endpoints: #{endpoints}"

      puts(<<~INFO.lines.map { |line| "    " + line }.join)
        [SEALING REQUEST]
        - Bundle ID: #{bundle_id}
        - Account ID: #{$account_id_hash}
        - SDK Version: #{$sdk_version}
        - Endpoint: #{endpoints[:sealing]}
      INFO
      debug_log "Sealing request for bundle_id=#{bundle_id}, account_id_hash=#{$account_id_hash}"

      sealing_complete = false
      progress = Thread.new do
        print "    [PROGRESS] Sealing process".ljust(32).cyan
        until sealing_complete
          print ".".cyan
          sleep 0.5
        end
      end

      response = nil
      Thread.new {
        begin
          debug_log "Sending archive to sealing endpoint"
          File.open(zip_path, "rb") do |jsfile|
            # --- sealing request with SSL-safe HTTP client ---
            http = ApiUtils.create_http(endpoints[:sealing])
            response = http.start do |h|
              request = Net::HTTP::Post.new(endpoints[:sealing])
              request.set_form([
                ["bundle_id", bundle_id],
                ["account_id_hash", $account_id_hash],
                ["sdk_version", $sdk_version],
                ["html5file", jsfile],
              ], "multipart/form-data")
              h.request(request)
            end
            debug_log "Initial API response: #{response.code} #{response.class}"

            handle_response(response, :sealing)
            pack_id = JSON.parse(response.body).dig("SEALING_INFO", "pack_id")
            debug_log "Returned pack_id: #{pack_id}"

            # --- status polling with SSL-safe HTTP client ---
            status_uri   = endpoints[:status]
            loop do
              http = ApiUtils.create_http(status_uri)
              response = http.start do |h|
                request = Net::HTTP::Post.new(status_uri)
                request.set_form([["pack_id", pack_id]], "multipart/form-data")
                h.request(request)
              end
              debug_log "Polled sealing status: Response #{response.code}"

              status_info = JSON.parse(response.body)
              status      = status_info.dig("SEALING_INFO", "status")
              debug_log "Server status=#{status}"

              case status
              when "2"
                debug_log "Seal process complete (status=2)"
                break
              when "3"
                error_msg = status_info.dig("SEALING_INFO", "message") || "Unknown server error"
                debug_log "Server sealing failed (status=3): #{error_msg}"
                raise "Server sealing failed (Status 3): #{error_msg}"
              end
              sleep 0.5
            end

            # --- download sealed result with SSL-safe HTTP client ---
            debug_log "Requesting sealed result file for pack_id=#{pack_id}"
            http = ApiUtils.create_http(endpoints[:download])
            response = http.start do |h|
              request = Net::HTTP::Post.new(endpoints[:download])
              request.set_form([
                ["bundle_id", bundle_id],
                ["account_id_hash", $account_id_hash],
                ["pack_id", pack_id],
              ], "multipart/form-data")
              h.request(request)
            end
            debug_log "Download sealed file response type: #{response['Content-Type']}"

            if response["Content-Type"].include?("application/json")
              debug_log "Sealed file download failed: got JSON instead of file"
              handle_response(response, :download)
            else
              debug_log "Writing final result to #{result_path}"
              File.write(result_path, response.body)
              system("cd #{Shellwords.escape(app)} && unzip -qo enc_main.zip")
              debug_log "Unzipped sealed bundle to #{app}"
              FileUtils.rm_f(["#{app}/main.zip", result_path])
              system("xattr -cr #{Shellwords.escape(app)}/main.jsbundle")
              debug_log "Post-extract cleanup complete"
            end
          end
        rescue => e
          server_message = begin
              JSON.parse(response.body)&.dig("SEALING_INFO", "message") rescue "N/A"
            end
          server_pack_id = begin
              JSON.parse(response.body)&.dig("SEALING_INFO", "pack_id") rescue "N/A"
            end

          puts <<~ERROR.red.bold
                 \n[ERROR] Sealing process failed
                 - Type: #{e.class}
                 - Message: #{e.message}
                 - Server Message: #{server_message}
                 - Server pack_id: #{server_pack_id}
                 - Bundle ID: #{bundle_id}
                 - Account ID: #{$account_id_hash}
                 - SDK Version: #{$sdk_version}
                 - HTTP Status: #{response&.code || "N/A"}
                 
                 Possible causes:
                 1. Server-side error: #{server_message}
                 2. Network connectivity issues
                 3. Invalid API credentials
                 4. Resource validation failure
               ERROR
          debug_log "Sealing thread error: #{e.class} - #{e.message}"
          debug_log "Server message: #{server_message}, pack_id: #{server_pack_id}, bundle_id: #{$bundle_id}, sdk_version: #{$sdk_version}"
          exit(false)
        ensure
          sealing_complete = true
          debug_log "Background sealing thread finished"
        end
      }.join

      progress.join
      puts "\n    [SUCCESS] JavaScript bytecode encryption completed successfully".green
      debug_log "encrypt_javascript_bytecode completed without error"
    ensure
      debug_log "Cleaning up temp files (#{zip_path}, #{result_path})"
      FileUtils.rm_f([zip_path, result_path]) rescue nil
    end
  end

  def self.handle_response(response, api_phase)
    debug_log "handle_response: phase=#{api_phase}, status=#{response.code}, class=#{response.class}"
    return if response.is_a?(Net::HTTPSuccess)

    # Attempt to extract server error message, fall back to body preview
    error_info = begin
        debug_log "Parsing error info from response body"
        JSON.parse(response.body).dig("result", "message") rescue response.body[0..200]
      end

    debug_log "API Error (phase=#{api_phase}): status=#{response.code}, message=#{error_info.inspect}"
    raise <<~ERROR.red.bold
            API Error (#{api_phase.to_s.upcase})
            - Status: #{response.code}
            - Message: #{error_info}
            - URI: #{response.uri}
          ERROR
  end
end


