    #----------------------------------------------------------------------------------------
    #    Objective-C helpers
    #----------------------------------------------------------------------------------------
    def self.extract_loc(node)
        loc   = node['loc']   || {}
        range = node['range'] || {}

        if range.is_a?(Hash)
            b = range['begin'] || range['start']
            if b.is_a?(Hash)
                file   = b['file']
                line   = b['line']
                column = b['column']
                return { 'file' => file, 'line' => line || 0, 'column' => column || 0 } if line && line > 0
            end
        end

        if loc['expansionLoc'].is_a?(Hash)
            loc = loc['expansionLoc']
        elsif loc['spellingLoc'].is_a?(Hash)
            loc = loc['spellingLoc']
        end

        file   = loc['file']
        line   = loc['line']
        column = loc['column']

        if (!line || line == 0) && range.is_a?(Hash)
            b = range['begin'] || range['start']
            if b.is_a?(Hash)
                file   ||= b['file']
                line   ||= b['line']
                column ||= b['column']
            end
        end

        { 'file' => file, 'line' => line || 0, 'column' => column || 0 }
    end

    def self.extract_selector(node)
        node['selector'] || node['sel'] || node['callee'] || node['name']
    end

    def self.extract_decl_name(node)
        name = node['name'] || node['referencedDecl'] || node['value'] || node['callee']
        if name.is_a?(Hash)
            name = name['name'] || name['identifier'] || name['spelling'] || name['qualName']
        end
        return nil unless name.is_a?(String)
        name.split(/[@\s]/).first
    end

    def self.normalize_class_from_qualtype(qual)
        return nil unless qual && qual.is_a?(String)
        klass = qual.split(/[ *<\[\]]/).first
        return nil if !klass || klass.empty?
        return nil if %w[BOOL bool void int long short char NSInteger NSUInteger id auto const volatile double float].include?(klass)
        klass
    end

    Env = Struct.new(:vars, :self_class)

    def self.build_env_from_ast(ast)
        vars       = {}
        self_class = nil

        walk = lambda do |node, current_self|
            kind = node['kind'] || ''

            if kind == 'ObjCInterfaceDecl' || kind == 'ObjCImplementationDecl'
                self_name   = node['name']
                current_self = self_name if self_name && !self_name.empty?

                (node['inner'] || []).each do |ch|
                    if ch['kind'] == 'ObjCIvarDecl' || ch['kind'] == 'FieldDecl'
                        iname    = ch['name']
                        type_obj = ch['type'] || ch['typeInfo'] || {}
                        qual     = type_obj.is_a?(Hash) ? (type_obj['qualType'] || type_obj['desugaredQualType']) : type_obj
                        klass    = self.normalize_class_from_qualtype(qual)
                        vars[iname] = klass if iname && klass
                    elsif ch['kind'] == 'ObjCPropertyDecl'
                        pname    = ch['name']
                        type_obj = ch['type'] || ch['typeInfo'] || {}
                        qual     = type_obj.is_a?(Hash) ? (type_obj['qualType'] || type_obj['desugaredQualType']) : type_obj
                        klass    = self.normalize_class_from_qualtype(qual)
                        vars[pname] = klass if pname && klass
                    end
                    walk.call(ch, current_self)
                end

                self_class = current_self unless self_class
                return
            end

            if kind == 'VarDecl' || kind == 'ParmVarDecl'
                name     = node['name']
                type_obj = node['type'] || node['typeInfo'] || {}
                qual     =
                    case type_obj
                    when Hash
                        type_obj['qualType'] || type_obj['desugaredQualType'] || type_obj['name']
                    when String
                        type_obj
                    else
                        nil
                    end
                if name && qual
                    klass = self.normalize_class_from_qualtype(qual)
                    vars[name] = klass if klass
                end
            end

            (node['inner'] || []).each { |ch| walk.call(ch, current_self) }
        end

        walk.call(ast, self_class)
        Env.new(vars, self_class)
    end

    def self.dig_for_receiver_info(node)
        return nil unless node.is_a?(Hash)
        kind = node['kind'] || ''

        case kind
        when 'DeclRefExpr'
            return { kind: 'DeclRefExpr', name: node['referencedDecl'] || node['name'], type: node['type'] }
        when 'ObjCClassRefExpr', 'ObjCInterfaceTypeExpr'
            return { kind: kind, name: node['name'] }
        when 'ImplicitCastExpr', 'CStyleCastExpr', 'ParenExpr', 'MaterializeTemporaryExpr', 'ExprWithCleanups'
            (node['inner'] || []).each do |ch|
                r = self.dig_for_receiver_info(ch)
                return r if r
            end
        when 'MemberExpr'
            base = node['base'] || (node['inner'] && node['inner'].first)
            return self.dig_for_receiver_info(base)
        end

        nil
    end

    def self.extract_objc_class_with_env(msg_node, env, code_line = nil)
        return nil unless msg_node.is_a?(Hash)

        type_obj =
            msg_node['receiverType']     ||
            msg_node['receiverTypeInfo'] ||
            msg_node['type']             ||
            msg_node['base']             ||
            msg_node['typeInfo']         || {}

        qual =
            case type_obj
            when Hash
                type_obj['qualType'] || type_obj['desugaredQualType'] || type_obj['name'] || type_obj['typeName']
            when String
                type_obj
            else
                nil
            end

        klass = self.normalize_class_from_qualtype(qual)
        return klass if klass

        inner = msg_node['inner'] || []
        receiver_expr = inner.find do |ch|
            k = ch['kind']
            %w[DeclRefExpr ObjCClassRefExpr ObjCInterfaceTypeExpr MemberExpr ImplicitCastExpr SuperExpr].include?(k)
        end

        if receiver_expr
            info = self.dig_for_receiver_info(receiver_expr)
            if info
                if info[:kind] == 'DeclRefExpr'
                    ref_name = info[:name]
                    if ref_name.is_a?(Hash)
                        ref_name = ref_name['name'] || ref_name['identifier'] || ref_name['spelling']
                    end

                    if ref_name.is_a?(String)
                        if env&.vars && env.vars[ref_name]
                            return env.vars[ref_name]
                        end

                        if ref_name =~ /^[A-Z][A-Za-z0-9_]+$/
                            return ref_name
                        end

                        return env.self_class if ref_name == 'super' && env&.self_class
                    end
                elsif info[:kind] == 'ObjCClassRefExpr' || info[:kind] == 'ObjCInterfaceTypeExpr'
                    rn = info[:name]
                    rn = rn['name'] if rn.is_a?(Hash)
                    klass2 = self.normalize_class_from_qualtype(rn)
                    return klass2 if klass2
                end
            end

            t = receiver_expr['type'] || receiver_expr['typeInfo']
            if t.is_a?(Hash)
                qc = t['qualType'] || t['desugaredQualType'] || t['name']
                kc = self.normalize_class_from_qualtype(qc)
                return kc if kc
            elsif t.is_a?(String)
                kc = self.normalize_class_from_qualtype(t)
                return kc if kc
            end
        end

        if inner.any? { |ch| (ch['kind'] || '') == 'SuperExpr' }
            return env.self_class
        end

        if code_line && code_line.is_a?(String) && !code_line.empty?
            if (m = code_line.match(/\[\s*([A-Za-z_][A-Za-z0-9_\.]*)\s+/))
                token = m[1]
                if token =~ /^[A-Z][A-Za-z0-9_]+(\.[A-Za-z0-9_]+)?$/
                    cand = token.split('.').first
                    return cand
                end
                return env.vars[token] if env&.vars && env.vars[token]
                return env.self_class if token == 'super'
            end

            if (m2 = code_line.match(/([A-Za-z_][A-Za-z0-9_]*)\./))
                var = m2[1]
                return env.vars[var] if env&.vars && env.vars[var]
            end
        end

        nil
    end

    #----------------------------------------------------------------------------------------
    #    Main Objective‑C scanner
    #----------------------------------------------------------------------------------------
    def self.scan_objc_file(file_path, indent = 1)
        self.log(" ")
        self.log(" -- Scanning Objective-C file (Clang AST): #{file_path}", :white, indent)

        unless File.exist?(file_path)
            self.log("[ERROR] File not found: #{file_path}", :red, indent + 1)
            return []
        end

        lines = File.readlines(file_path, chomp: true)

        clang_cmd = [
            'clang',
            '-Xclang', '-ast-dump=json',
            '-fsyntax-only',
            '-x', 'objective-c',
            '-fobjc-arc',
            file_path
        ]

        stdout, stderr, status = Open3.capture3(*clang_cmd)
        unless status.success?
            self.log("[ERROR] Clang AST failed: #{stderr}", :red, indent + 1)
            return []
        end

        begin
            ast = JSON.parse(stdout)
        rescue => e
            self.log("[ERROR] Failed to parse JSON AST: #{e}", :red, indent + 1)
            return []
        end

        env                = self.build_env_from_ast(ast)
        allowed_objc       = ALLOWED_OBJC_METHODS
        meta_methods       = FILE_META_METHODS
        non_io_methods     = NON_IO_METHODS
        unsafe_posix_funcs = UNSAFE_POSIX_FUNCS

        findings = []
        seen     = {}

        scan_node = lambda do |node, parent_loc|
            kind     = node['kind'] || ''
            own_loc  = self.extract_loc(node)
            loc_info = (own_loc['line'] && own_loc['line'] > 0) ? own_loc : (parent_loc || own_loc)

            line      = loc_info['line'] || 0
            code_line = (line > 0 && line <= lines.size) ? lines[line - 1] : ''

            if kind == 'DeclRefExpr' || kind == 'declRef'
                name = self.extract_decl_name(node)
                if name && unsafe_posix_funcs.include?(name)
                    key = [file_path, line, 'POSIX', name, code_line]
                    unless seen[key]
                        seen[key] = true
                        self.log(" ")
                        indent2 = ' ' * 4 * (indent + 1)
                        print "#{indent2}\e[35mPOSIX function used: \e[0m"
                        print "\e[33m#{name}\e[0m\n"
                        self.log("Line #{line}: #{self.code_line_at(file_path, line)}", :orange, indent + 2)
                        findings << { file: file_path, line: line, type: 'POSIX', func: name }
                    end
                end
            elsif kind == 'CallExpr'
                callee      = node['callee'] || node['name']
                callee_name = callee.is_a?(Hash) ? self.extract_decl_name(callee) : callee
                if callee_name && unsafe_posix_funcs.include?(callee_name)
                    key = [file_path, line, 'POSIX', callee_name, code_line]
                    unless seen[key]
                        seen[key] = true
                        indent2 = ' ' * 4 * (indent + 1)
                        print "#{indent2}\e[31mPOSIX function used: \e[0m"
                        print "\e[33m#{callee_name}\e[0m\n"
                        self.log("Line #{line}: #{self.code_line_at(file_path, line)}\n", :orange, indent + 2)
                        findings << { file: file_path, line: line, type: 'POSIX', func: callee_name }
                    end
                end
            end

            if ['ObjCMessageExpr', 'messageSend'].include?(kind)
                selector = self.extract_selector(node)
                klass    = self.extract_objc_class_with_env(node, env, code_line)

                unless selector
                    (node['inner'] || []).each { |child| scan_node.call(child, loc_info) }
                    return
                end

                display_class = klass

                if !display_class
                    r = node['receiver'] || node['objcReceiver'] || node['base'] || node['callee']
                    if r.is_a?(Hash)
                        candidate = r['name'] || r['referencedDecl'] || r['spelling']
                        if candidate.is_a?(Hash)
                            candidate = candidate['name'] || candidate['identifier'] || candidate['spelling']
                        end
                        if candidate.is_a?(String)
                            c = self.normalize_class_from_qualtype(candidate)
                            display_class = c if c
                        end
                    end
                end

                display_name_for_log = display_class ? "[#{display_class} #{selector}]" : "[ #{selector}]"

                if non_io_methods && !non_io_methods.empty?
                    sel_no_colon = selector.to_s.sub(/:+$/, '')
                    is_non_io =
                        non_io_methods.include?(selector)       ||
                        non_io_methods.include?("#{selector}:") ||
                        non_io_methods.include?(sel_no_colon)

                    if is_non_io
                        (node['inner'] || []).each { |child| scan_node.call(child, loc_info) }
                        return
                    end
                end

                if display_class &&
                    %w[NSString NSMutableString NSArray NSMutableArray NSDictionary NSMutableDictionary].include?(display_class)
                    (node['inner'] || []).each { |child| scan_node.call(child, loc_info) }
                    return
                end

                if display_class && !FILE_IO_OBJC_CLASSES.include?(display_class)
                    (node['inner'] || []).each { |child| scan_node.call(child, loc_info) }
                    return
                end

                sel_no_colon   = selector.to_s.sub(/:+$/, '')
                all_meta_names = meta_methods.values.flatten
                is_meta =
                    all_meta_names.include?(selector)       ||
                    all_meta_names.include?("#{selector}:") ||
                    all_meta_names.include?(sel_no_colon)

                if is_meta
                    (node['inner'] || []).each { |child| scan_node.call(child, loc_info) }
                    return
                end

                allowed = false
                if display_class && allowed_objc[display_class]
                    allowed = allowed_objc[display_class].include?(selector)
                end

                unless allowed
                    allowed_names = allowed_objc.values.flatten
                    allowed =
                        allowed_names.include?(selector)       ||
                        allowed_names.include?("#{selector}:") ||
                        allowed_names.include?(sel_no_colon)
                end

                if allowed
                    (node['inner'] || []).each { |child| scan_node.call(child, loc_info) }
                    return
                end

                key = [file_path, line, display_class, selector, code_line]
                unless seen[key]
                    seen[key] = true
                    self.log(" ")
                    indent2 = ' ' * 4 * (indent + 1)
                    print indent2
                    print "\e[31mNon-allowed method detected: \e[0m"
                    print "\e[33m#{display_name_for_log}\e[0m\n"
                    self.log("Line #{line}: #{self.code_line_at(file_path, line)}", :orange, indent + 2)

                    findings << {
                        file:   file_path,
                        line:   line,
                        type:   'ObjC',
                        class:  display_class,
                        method: selector
                    }
                end
            end

            (node['inner'] || []).each { |child| scan_node.call(child, loc_info) }
        end

        scan_node.call(ast, nil)
        self.log("\n") unless findings.empty?
        findings
    end

    EXCLUDE_FILES = [
        /AppsealingiOS\.h$/i,
        /AppsealingiOS\.mm$/i,
        /LEASection\.mm$/i
    ]

    EXCLUDE_FOLDERS = [
        /AppSealingSDK\//
    ]

    #----------------------------------------------------------------------------------------
    #    Dispatch scan based on file extension
    #----------------------------------------------------------------------------------------
    def self.scan_file(file, indent = 2)
        return [] if EXCLUDE_FILES.any?   { |r| file =~ r }
        return [] if EXCLUDE_FOLDERS.any? { |r| file =~ r }

        case File.extname(file)
        when ".swift"
            self.scan_swift_file(file, indent)
        when ".m", ".mm", ".c", ".cpp"
            self.scan_objc_file(file, indent)
        else
            []
        end
    rescue => e
        self.log("[ERROR] scan_file exception: #{e}", :red, indent)
        []
    end

    #----------------------------------------------------------------------------------------
    #    Traverse folder and collect source files
    #----------------------------------------------------------------------------------------
    def self.traverse_folder(folder, sources = [], indent = 1)
        Dir.entries(folder).each do |entry|
            next if entry == "." || entry == ".."
            path = File.join(folder, entry)
            if File.directory?(path)
                self.traverse_folder(path, sources, indent + 1)
            elsif path =~ /\.(swift|m|mm|c|cpp)$/
                sources << path unless sources.include?(path)
            end
        end
        sources
    end

    #----------------------------------------------------------------------------------------
    #    Collect source files for target
    #----------------------------------------------------------------------------------------
    def self.collect_target_sources(project, target)
        project_dir = File.dirname(project.path)
        sources     = []

        traverse_group = lambda do |group|
            return if group.nil?

            if group.respond_to?(:children)
                group.children.each { |c| traverse_group.call(c) rescue nil }
            end

            if group.is_a?(Xcodeproj::Project::Object::PBXFileSystemSynchronizedRootGroup)
                real_path = File.join(project_dir, group.path || "")
                if Dir.exist?(real_path)
                    self.traverse_folder(real_path, sources)
                end
            end

            if group.respond_to?(:files)
                group.files.each do |file_ref|
                    next if file_ref.nil? || file_ref.path.nil?
                    path = File.join(project_dir, file_ref.path)
                    sources << path unless sources.include?(path)
                end
            end
        end

        traverse_group.call(project.main_group)

        if target.respond_to?(:source_build_phase)
            target.source_build_phase.files.each do |bf|
                next if bf.file_ref.nil?
                file_path = bf.file_ref.real_path.to_s
                sources << file_path unless sources.include?(file_path)
            end
        end

        lea_path = File.join(project_dir, 'AppSealingSDK', 'Libraries', 'LEASection.mm')
        sources << lea_path if File.exist?(lea_path) && !sources.include?(lea_path)

        sources.compact.uniq
    end

    #----------------------------------------------------------------------------------------
    #    Find Xcode project
    #----------------------------------------------------------------------------------------
    def self.find_xcodeproj(start_dir)
        dir = Pathname.new(start_dir)
        while !dir.root?
            proj = Dir[File.join(dir.to_s, '*.xcodeproj')]
            return proj[0] unless proj.empty?
            dir = dir.parent
        end
        nil
    end

    #----------------------------------------------------------------------------------------
    #    Main Secure FileIO check
    #----------------------------------------------------------------------------------------
    def self.check_secure_fileio(project_path)
        self.log(" ")
        self.log("[INFO] Starting Secure FileIO validation...", :green, 1)

        xcodeproj_path = self.find_xcodeproj(project_path)
        unless xcodeproj_path
            self.log("[ERROR] Cannot find Xcode project from: #{project_path}", :red, 1)
            exit(1)
        end

        self.log("Found Xcode project at: #{xcodeproj_path}", :cyan, 1)

        begin
            project = Xcodeproj::Project.open(xcodeproj_path)
        rescue => e
            self.log("[ERROR] Can't open project: #{e}", :red, 1)
            exit(1)
        end

        if project.targets.empty?
            self.log("[ERROR] No target in Xcode project", :red, 1)
            exit(1)
        end

        target = project.targets.first

        self.log(" ")
        self.log("Processing target: #{target.name}", :green, 1)

        sources = self.collect_target_sources(project, target)
        self.log("Found #{sources.size} source files for target '#{target.name}'.", :green, 1)

        all_findings = []
        sources.each_with_index do |file, idx|
            all_findings.concat(self.scan_file(file, 2))
        end

        if all_findings.empty?
            self.log("\n ✅ Secure File I/O methods scan completed: No problem found", :green)
            true
        else
            self.log("\n ❌ Secure File I/O methods scan completed: #{all_findings.size} sensitive issue(s) found".bold, :red)

            if $action == "securefile-verify"
                false
            else
                print "\n ==> If you use these methods, file contents cannot be written/read normally.\n Do you want to continue anyway (is it intended)? Type 'YES' to proceed: ".yellow.bold
                input = STDIN.gets.strip
                if input == "YES"
                    self.log(" ")
                    puts " User confirmed to proceed.".cyan.bold
                    true
                else
                    self.log(" ")
                    self.log(" Aborted by user.\n", :orange, 0)
                    false
                end
            end
        end
    end

    #----------------------------------------------------------------------------------------
    #    Print allowed methods (for docs)
    #----------------------------------------------------------------------------------------
    def self.print_allowed_methods
        indent = ' ' * 4

        self.log("#{indent}================================================================================", :cyan)
        self.log("#{indent} Secure Filesystem - Allowed API List".bold, :yellow)
        self.log("#{indent}-------------------------------------------------------------------------------", :cyan)
        self.log("#{indent} Only the following Swift / Objective-C methods are permitted", :cyan)
        self.log("#{indent} when Secure Filesystem verification is enabled.\n", :cyan)

        self.log("#{indent}-------------------------------------------------------------------------------", :cyan)
        self.log("#{indent} [Swift Allowed Methods]".bold, :green)
        self.log("#{indent}-------------------------------------------------------------------------------", :cyan)

        ALLOWED_SWIFT_METHODS.reject { |k, _| ["Data", "NSMutableData"].include?(k) }.each do |klass, methods|
            if klass == "NSData"
                print "#{indent}\e[1m\e[36m • #{klass}\e[0m "
                print "\e[1m\e[38;5;208m(NOT Data!)\e[0m\n"
            else
                self.log(" ", :default)
                self.log("#{indent} • #{klass.bold}", :cyan, 0)
            end
            methods.each { |m| self.log("#{indent} - #{m}", :default, 0) }
        end

        self.log(" ", :default)
        self.log("#{indent}-------------------------------------------------------------------------------", :cyan)
        self.log("#{indent} [Objective-C Allowed Methods]".bold, :green)
        self.log("#{indent}-------------------------------------------------------------------------------", :cyan)

        ALLOWED_OBJC_METHODS.reject { |k, _| ["NSMutableData", "NSConcreteFileHandle"].include?(k) }.each do |klass, methods|
            self.log(" ", :default) if klass != "NSData"
            self.log("#{indent} • #{klass.bold}", :cyan, 0)
            methods.each { |m| self.log("#{indent} - #{m}", :default, 0) }
        end

        self.log(" ", :default)
        self.log("#{indent}================================================================================\n\n", :cyan)
    end
end


class AppSealingCLI
  attr_reader :ipa_path, :options

  def initialize(argv)
    @argv     = argv
    @ipa_path = nil
    @options  = {}
  end

  def parse_and_validate_args!
    # --- apply / restore handler ---
    if @argv.length >= 1 && (%w[apply restore].include?(@argv[0]))
      @options[:action]       = @argv[0]
      @options[:project_path] = @argv[1]
      debug_log "Starting string_encryption_main with action=#{@options[:action]}, project_path=#{@options[:project_path]}" if defined?(debug_log)
      StringEncryption.string_encryption_main( project_path: @options[:project_path], action:@options[:action] )
      exit(0)
    end

    # --- securefile-verify handler ---
    if @argv.length >= 1 && @argv[0] == "securefile-verify"
      @options[:action]       = @argv[0]
      @options[:project_path] = @argv[1]

      $action = @options[:action]
      unless SecureFilesystem.check_secure_fileio(@options[:project_path])
        print "\n ==> If you use these methods, file contents cannot be written/read normally.\n" \
              " Do you want to view the allowed methods list? Type 'Y' to print : ".yellow.bold
        input = STDIN.gets.strip
        if input == "Y" || input == "y"
          puts " "
          SecureFilesystem.print_allowed_methods
        end
      end
      exit(0)
    end

    # --- IPA argument validation ---
    if @argv.length < 1 || File.extname(@argv[0]).delete(".").downcase != "ipa"
      puts ".\n.\nusage: generate_hash YourApp.IPA [-url_scheme=url] [-camera=NSCameraUsageDescription] [-antihook=enable|disable] [-antiswizzle=enable|disable] [-securefile=enable|disable]".yellow
      puts "         url : URL scheme for Unreal app [optional]".yellow
      puts "         camera : camera usage description string to put into Info.plist [optional]".yellow
      puts "         antihook : enable or disable anti-hooking feature [optional, default=enabled]".yellow
      puts "         antiswizzle : enable or disable anti-swizzling feature [optional, default=disabled]".yellow
      puts "         securefile : enable or disable secure filesystem (automatic file encryption) [optional, default=disabled]".yellow
      puts ".\n.\n.\n".yellow
      exit(false)
    end

    puts <<~INTRO.bold.green
               +-------------------------------------------------------------------------------------+
               |                                                                                     |
               |  AppSealing IPA Hash Generator V1.12.0.0 : provided by Doverunner                   |
               |                                                                                     |
               +-------------------------------------------------------------------------------------+
            INTRO

    puts "[Target IPA]         = #{@argv[0].to_s}"
    debug_log "Target IPA input: #{@argv[0]}" if defined?(debug_log)

    # --- Validate IPA absolute path ---
    @ipa_path = Pathname.new(@argv[0])
    unless @ipa_path.absolute?
      puts "    [Error] Please provide an absolute path for the IPA file.".red
      debug_log "Error: IPA path not absolute: #{@argv[0]}" if defined?(debug_log)
      exit(false)
    end

    # --- CLI option parsing ---
    @argv.each_with_index do |arg, i|
      next if i == 0   # first argument is IPA path
      key, value = arg.split("=", 2)
      case key
      when "-url_scheme"
        @options[:url_scheme] = value
        puts "[URL Scheme]         = #{value}"
        debug_log "Parsed URL Scheme: #{value}" if defined?(debug_log)
      when "-camera"
        @options[:camera_desc] = value
        puts "[Camera Description] = #{value}"
        debug_log "Parsed Camera Description: #{value}" if defined?(debug_log)
      when "-version"
        @options[:version] = value
        puts "[Version]            = #{value}"
        debug_log "Parsed requested version: #{value}" if defined?(debug_log)
      when "-antihook"
        @options[:antihook] = value
        puts "[Anti-Hooking]       = #{value}"
        debug_log "Parsed anti-hooking option: #{value}" if defined?(debug_log)
      when "-antiswizzle"
        @options[:antiswizzle] = value
        puts "[Anti-Swizzling]     = #{value}"
        debug_log "Parsed anti-swizzling option: #{value}" if defined?(debug_log)
      when "-securefile"
        @options[:securefile] = value
        puts "[Secure-Filesystem]  = #{value}"
        debug_log "Parsed secure filesystem option: #{value}" if defined?(debug_log)
      end
    end
  end
end

#--------------------------------------------------------------------------------------------
#  PlistManager 클래스는 plist 파일을 관리하는 기능을 제공합니다.
#  This class provides management and manipulation functions for XML .plist files,
#  including read, write, update, and key operations via REXML.
#--------------------------------------------------------------------------------------------
require "rexml/document"
include REXML

class PlistManager
  # Initialize a PlistManager for a given plist file path.
  # Loads the file as an XML document into memory.
  def initialize(file_path)
    @file_path = file_path # plist 파일 경로를 인스턴스 변수로 저장
                           # Store the plist file path as an instance variable
    @doc = nil             # plist 파일의 XML 데이터를 저장할 변수
                           # Holds the parsed XML document in memory
    load_file              # 파일을 로드하여 XML 문서를 초기화
                           # Immediately load the XML into memory on initialization
  end

  # Reads the plist file and loads it into memory as a REXML::Document object.
  # Raises error and exits on file load failure.
  def load_file
    File.open(@file_path, "r") do |file|
      @doc = REXML::Document.new(file) # XML 문서 객체 생성
      # Create an XML document object in memory
      debug_log "Plist loaded successfully from: #{@file_path}" if defined?(debug_log)
    end
  rescue StandardError => e
    puts "    [Error] loading file: #{e.message}".red # 파일 읽기 실패 시 에러 메시지 출력
    debug_log "Failed to load plist: #{e.class} - #{e.message}" if defined?(debug_log)
    exit(false)
  end

  # 현재 메모리에 로드된 XML 문서를 plist 파일에 저장합니다.
  # Writes the current XML document from memory back to the plist file,
  # ensuring pretty print format and normalizing XML declaration/doctype quotes.
  def save_file
    File.open(@file_path, "w") do |file|
      formatter = REXML::Formatters::Pretty.new(4) # 들여쓰기 4칸 설정
      formatter.compact = true                     # 빈 줄 제거
      formatter.write(@doc, file)                  # XML 문서를 파일에 출력
    end

    # 저장된 파일을 다시 읽어와서 XML 선언 부분의 작은따옴표를 큰따옴표로 변환
    # Post-process the saved file to normalize quotes in XML declaration and plist tag
    content = File.read(@file_path)
    content.gsub!(/<\?xml version='1\.0' encoding='UTF-8'\?>/, '<?xml version="1.0" encoding="UTF-8"?>')
    content.gsub!(/<plist version='1\.0'>/, '<plist version="1.0">')
    File.write(@file_path, content)

    debug_log "Plist file saved and normalized: #{@file_path}" if defined?(debug_log)
  rescue StandardError => e
    puts "    [Error] saving file: #{e.message}".red # 파일 저장 중 오류 발생 시 메시지 출력
    debug_log "Failed to save plist: #{e.class} - #{e.message}" if defined?(debug_log)
    exit(false)
  end

  # Updates or inserts a value for a given key in the plist.
  # If value is nil, removes the key.
  # Handles strings and arrays; replaces type as needed.
  def update_key(key, value)
    debug_log "update_key called: key='#{key}', value=#{value.inspect}" if defined?(debug_log)

    element = REXML::XPath.first(@doc, "//key[text()='#{key}']") # key를 찾음
    # Search for <key> element with matching name

    if value.nil?
      # value가 nil이면 key와 값을 삭제
      # If value is nil, remove key and associated value
      debug_log "Removing key because value is nil: #{key}" if element && defined?(debug_log)
      remove_key(element) if element
    elsif element
      # key가 존재하면 값 업데이트
      # If key exists, update its value
      next_element = element.next_element
      if next_element && next_element.name == "string" && value.is_a?(String)
        # 기존 값이 문자열일 경우 업데이트
        # If current value is a string and new value is also string, update in place
        debug_log "Updating existing string key: #{key} → #{value}" if defined?(debug_log)
        next_element.text = value
      else
        # 타입이 다르면 제거 후 새로 추가
        # If type mismatch or not a <string>, remove and re-add
        debug_log "Replacing existing key due to type mismatch: #{key}" if defined?(debug_log)
        remove_key(element)
        add_new_key(key, value)
      end
    else
      # key가 없으면 새로 추가
      # If key doesn't exist, add it fresh
      debug_log "Adding new key: #{key} => #{value}" if defined?(debug_log)
      add_new_key(key, value)
    end
  end

  # Reads the value for a given key.
  # Returns String, Array, true, false, or nil depending on value type.
  def read(key)
    debug_log "read called for key: #{key}" if defined?(debug_log)

    element = REXML::XPath.first(@doc, "//key[text()='#{key}']") # 해당 <key> 요소를 찾음
    # Locate the <key> element with the given name
    return nil unless element

    next_element = element.next_element # 해당 key의 다음 요소 (value 요소)

    case next_element.name
    when "string"
      debug_log "Found string value for key #{key}: #{next_element.text}" if defined?(debug_log)
      next_element.text # 문자열 값을 반환
    when "array"
      values = next_element.elements.map(&:text) # 배열 값을 반환 (각 요소의 텍스트)
      debug_log "Found array value for key #{key}: #{values.inspect}" if defined?(debug_log)
      values
    when "true"
      debug_log "Found boolean true for key #{key}" if defined?(debug_log)
      true  # <true/> 값을 처리
    when "false"
      debug_log "Found boolean false for key #{key}" if defined?(debug_log)
      false # <false/> 값을 처리
    else
      debug_log "Unsupported or missing value type for key #{key}" if defined?(debug_log)
      nil   # 처리하지 않는 타입의 경우 nil 반환
    end
  end

  # Updates or sets the CFBundleURLSchemes for the first dict under CFBundleURLTypes.
  # - Replaces all existing schemes with the given new scheme string.
  # - Adds necessary <key>/<array> nodes if missing.
  def update_url_scheme(new_scheme)
    debug_log "update_url_scheme called with: #{new_scheme}" if defined?(debug_log)

    # CFBundleURLTypes 배열 찾기
    # Locate CFBundleURLTypes array
    url_types_array = XPath.first(@doc, "//key[text()='CFBundleURLTypes']/following-sibling::array")

    if url_types_array
      # CFBundleURLTypes 내부의 첫 <dict> 요소 찾기
      # Locate the first dict element within the CFBundleURLTypes array
      dict_element = url_types_array.elements["dict"]
      if dict_element
        # CFBundleURLSchemes 키의 array 요소 찾기
        # Locate CFBundleURLSchemes array within that dict
        schemes_key = dict_element.elements["key[text()='CFBundleURLSchemes']"]
        schemes_array = schemes_key&.next_element

        if schemes_array && schemes_array.name == "array"
          # 기존 scheme 전부 삭제 후 새 scheme 등록
          # Replace existing schemes with the new scheme
          debug_log "Replacing existing URL schemes with: #{new_scheme}" if defined?(debug_log)
          schemes_array.elements.each { |e| schemes_array.delete(e) }
          schemes_array.add_element("string").text = new_scheme
        else
          # CFBundleURLSchemes 요소가 없으면 새로 생성
          # If CFBundleURLSchemes doesn't exist, create key and array
          debug_log "CFBundleURLSchemes not found — creating new key/array block" if defined?(debug_log)
          new_schemes_key = Element.new("key")
          new_schemes_key.text = "CFBundleURLSchemes"
          new_schemes_array = Element.new("array")
          new_schemes_array.add_element("string").text = new_scheme

          dict_element.add_element(new_schemes_key)
          dict_element.add_element(new_schemes_array)
        end
      else
        puts "    [WARN] No <dict> element found under CFBundleURLTypes.".yellow
        debug_log "Missing <dict> under CFBundleURLTypes — cannot set scheme" if defined?(debug_log)
      end
    else
      puts "    [WARN] No CFBundleURLTypes found in the plist.".yellow
      debug_log "CFBundleURLTypes key not found — cannot set scheme" if defined?(debug_log)
    end
  end

  # plist 파일의 내용을 콘솔에 출력합니다.
  # Prints the entire plist XML to console with pretty format.
  def print
    debug_log "Printing current plist document to console" if defined?(debug_log)

    puts "======================================================================================================================="
    formatter = REXML::Formatters::Pretty.new(4) # 들여쓰기 4칸 설정
                                                 # Use 4-space indentation
    formatter.compact = true                     # 빈 줄 제거
                                                 # Remove extra line breaks
    formatter.write(@doc, $stdout)               # 콘솔에 출력
                                                 # Write XML to stdout
    puts                                          # 줄바꿈 추가 (출력 후)
    puts "-----------------------------------------------------------------------------------------------------------------------"
  end

  # Helper: Adds a new key/value pair to the root dict.
  # value may be a string or array of strings.
  def add_new_key(key, value)
    dict_element = REXML::XPath.first(@doc, "//dict")   # 최상위 <dict> 요소 찾기
                                                        # Locate the top-level <dict> element
    return unless dict_element                          # <dict> 요소가 없으면 종료
                                                        # Exit if no <dict> found

    key_element = REXML::Element.new("key")             # 새로운 <key> 요소 생성
                                                        # Create a new <key> element
    key_element.text = key                              # <key>에 텍스트 설정
                                                        # Assign the key name as text
    dict_element.add_element(key_element)               # <dict>에 <key> 추가
                                                        # Add the <key> to the <dict>

    if value.is_a?(Array)
      array_element = REXML::Element.new("array")     # 배열 값일 경우 <array> 생성
                                                      # If value is an Array, create an <array> element
      value.each do |val| # 각 배열 항목 추가
        array_element.add_element("string").text = val
      end
      dict_element.add_element(array_element)         # <dict>에 <array> 추가
                                                      # Add the array to the dict after the key
      debug_log "Added key '#{key}' with array of #{value.size} string(s)" if defined?(debug_log)
    else
      string_element = REXML::Element.new("string")   # 문자열 값일 경우 <string> 생성
                                                      # If value is a String, create a <string> element
      string_element.text = value
      dict_element.add_element(string_element)        # <dict>에 <string> 추가
                                                      # Add the string to the dict after the key
      debug_log "Added key '#{key}' with string value: #{value}" if defined?(debug_log)
    end
  end

  # ... any other public instance methods (like update_url_scheme) ...

  private

  # Adds a <string> element after the given key.
  def add_string_element(key_element, value)
    dict_element = key_element.parent
    dict_element.add_element("string").text = value
    debug_log "Added <string> to key '#{key_element.text}' with value: #{value}" if defined?(debug_log)
  end

  # Removes the key/value entry for the given key element from the plist.
  def remove_key(key_element)
    return unless key_element
    dict_element = key_element.parent
    next_element = key_element.next_element
    dict_element.delete(key_element)
    dict_element.delete(next_element) if next_element
    debug_log "Removed key '#{key_element.text}' and its value from plist" if defined?(debug_log)
  end
end

