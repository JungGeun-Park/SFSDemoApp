#--------------------------------------------------------------------------------------------
# GenesisService 클래스는 스냅샷과 에셋 정보를 앱실링 서버로 전송하여 genesis 파일을 생성합니다.
# Sends snapshot and assets data to AppSealing API server to generate the genesis file.
#--------------------------------------------------------------------------------------------
class GenesisService
  # Create Net::HTTP with proper SSL verification and cert store.

  def self.request_genesis(snapshot, assets, options = {})
    $current_step = options[:current_step] if options[:current_step]

    puts "\n[STEP #{$current_step}] Encrypting app integrity/certificate snapshot ...".bold.yellow

    begin
      # 1. Validate and convert to hex
      puts "    [DEBUG] Converting snapshot/assets to hex".yellow
      debug_log "Converting snapshot + assets to hex" if defined?(debug_log)

      raise "Invalid snapshot data" unless snapshot.is_a?(String) && !snapshot.empty?

      snapshot_hex = snapshot.unpack1("H*")
      assets_hex   = assets.unpack1("H*")
      puts "    [DEBUG] Hex conversion successful".yellow
      debug_log "Hex (snapshot): #{snapshot_hex[0..40]}..." if defined?(debug_log)
      debug_log "Hex (assets):   #{assets_hex[0..40]}..."   if defined?(debug_log)

      # 2. Validate required parameters
      required_vars = {
        account_id_hash: options[:account_id_hash],
        bundle_id:       options[:bundle_id],
        sdk_version:     options[:sdk_version],
        baseURL:         options[:baseURL],
      }

      missing = required_vars.select { |_, v| v.nil? || v.to_s.strip.empty? }.keys
      unless missing.empty?
        puts "    [ERROR] Missing required parameters: #{missing.join(', ')}".red
        debug_log "Missing required fields: #{missing.join(', ')}" if defined?(debug_log)
        raise "Missing required parameters: #{missing.join(', ')}"
      end

      # 3. Execute API request (with SSL-safe HTTP client)
      uri = URI.parse("#{options[:baseURL]}v3/sdk/ios/requestGenesisForIOS")
      http = ApiUtils.create_http(uri)
      http.open_timeout = 15
      http.read_timeout = 30
      debug_log "Posting to #{uri}" if defined?(debug_log)

      request   = Net::HTTP::Post.new(uri)
      form_data = [
        ["account_id_hash", options[:account_id_hash]],
        ["bundle_id",       options[:bundle_id]],
        ["snapshot",        snapshot_hex],
        ["assets",          assets_hex],
        ["sdk_version",     options[:sdk_version]],
      ]
      request.set_form(form_data, "multipart/form-data")

      puts "    [INFO] Sending request to #{uri}".cyan
      response = http.start { |h| h.request(request) }

      # 4. Handle response
      unless response.code == "200"
        debug_log "HTTP failure: #{response.code} - #{response.message}" if defined?(debug_log)
        raise "HTTP Error: #{response.code} - #{response.message}"
      end

      parsed_response = JSON.parse(response.body)
      result_code     = parsed_response.dig("result", "code")
      unless result_code == "0000"
        error_msg = parsed_response.dig("result", "message") || "Unknown error"
        debug_log "API error: #{error_msg}" if defined?(debug_log)
        raise "API Error: #{error_msg}"
      end

      genesis_hex = parsed_response["genesis"]
      unless genesis_hex.is_a?(String) && !genesis_hex.empty?
        debug_log "Invalid genesis data received" if defined?(debug_log)
        raise "Invalid genesis data in response"
      end

      # 5. Save file
      genesis_path = File.join(options[:app_path], "genesis")
      puts "    [INFO] Writing genesis file to #{genesis_path}".cyan
      debug_log "Writing genesis to #{genesis_path}" if defined?(debug_log)

      File.open(genesis_path, "wb") do |f|
        f.write([genesis_hex].pack("H*")) # Convert hex string back to binary
      end

      puts "    [SUCCESS] Genesis file saved successfully".green
      debug_log "Genesis file size: #{genesis_hex.length / 2} bytes" if defined?(debug_log)

      true
    rescue JSON::ParserError => e
      puts <<~ERROR.red.bold
             [CRITICAL] Failed to parse API response
             Response Body: #{response.body[0..200]}...
             Error: #{e.message}
           ERROR
      debug_log "JSON ParserError: #{e.message}" if defined?(debug_log)
      exit(false)
    rescue => e
      puts <<~ERROR.red.bold
             [ERROR] Process failed
             Step: #{$current_step}
             Message: #{e.message}
             Backtrace:
             #{e.backtrace.first(5).join("\n")}
           ERROR
      debug_log "Genesis request failure: #{e.message}" if defined?(debug_log)
      exit(false)
    end
  end
end

