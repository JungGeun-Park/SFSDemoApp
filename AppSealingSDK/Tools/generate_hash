require "fileutils"

#--------------------------------------------------------------------------------------------
# CertificateExtractor 클래스는 PEM 및 텍스트 인증서 파일에서 상세 인증서 정보를 추출합니다.
# Extracts detailed certificate fields from PEM and certificate txt files.
#--------------------------------------------------------------------------------------------
class CertificateExtractor
  attr_reader :app_id, :team_id, :certificate_summary

  def initialize(folder, app_id, team_id)
    @folder = folder
    @app_id = app_id
    @team_id = team_id
    @certificate_summary = ""
    @cert_info = prepare_cert_info_hash
  end

  def extract_info
    ["0", "1", "2"].each do |i|
      extract_certificates(i)
    end

    add_protection_flags
    puts "    [INFO] Certificate extraction completed.".cyan
    debug_log "Final certificate summary size: #{@certificate_summary.bytesize} bytes" if defined?(debug_log)

    @certificate_summary
  end

  private

  def prepare_cert_info_hash
    hash = {}
    ["0", "1", "2"].each do |i|
      hash["subject#{i}"] = ""
      hash["issuer#{i}"] = ""
      hash["serial#{i}"] = ""
      hash["pubkey#{i}"] = ""
      hash["valid_from#{i}"] = ""
      hash["valid_to#{i}"] = ""
      hash["app_id#{i}"] = ""
      hash["team_id#{i}"] = ""
    end
    hash
  end

  def extract_certificates(i)
    pem_file = File.join(@folder, "pemformat#{i}.txt")
    cert_file = File.join(@folder, "certificate#{i}.txt")

    unless File.exist?(pem_file)
      puts "    [ERROR] PEM file not found: #{pem_file}".red
      debug_log "PEM file missing: #{pem_file}" if defined?(debug_log)
      return
    end

    puts "    [INFO] Processing PEM file: #{pem_file}".cyan
    debug_log "Processing PEM: #{pem_file}" if defined?(debug_log)
    process_pem_file(pem_file, i)

    unless File.exist?(cert_file)
      puts "    [ERROR] Certificate file not found: #{cert_file}".red
      debug_log "Certificate text missing: #{cert_file}" if defined?(debug_log)
      return
    end

    puts "    [INFO] Processing certificate file: #{cert_file}".cyan
    debug_log "Processing certificate TXT: #{cert_file}" if defined?(debug_log)
    process_cert_file(cert_file, i)

    build_certificate_summary(i)
  end

  def process_pem_file(pem_file, i)
    current_mode = nil
    File.foreach(pem_file) do |line|
      if line.start_with?("Modulus")
        current_mode = "pubkey#{i}"
        next
      elsif line.start_with?("Exponent")
        current_mode = nil
        next
      end
      @cert_info[current_mode] += line.strip if current_mode
    end
  rescue => e
    puts "    [ERROR] Failed to process PEM file #{pem_file}: #{e.message}".red
    debug_log "PEM read error: #{e.class} - #{e.message}" if defined?(debug_log)
  end

  def process_cert_file(cert_file, i)
    current_mode = nil
    File.foreach(cert_file) do |line|
      case line
      when /^subject=/
        current_mode = "subject#{i}"
        next
      when /^issuer=/
        current_mode = "issuer#{i}"
        next
      when /^serial=/
        @cert_info["serial#{i}"] = line.split("=", 2)[1].to_s.strip
        next
      when /^notBefore=/
        @cert_info["valid_from#{i}"] = line.split("=", 2)[1].to_s.strip
        next
      when /^notAfter=/
        @cert_info["valid_to#{i}"] = line.split("=", 2)[1].to_s.strip
        next
      when /^-----BEGIN PUBLIC KEY-----/
        current_mode = "pubkey#{i}"
        next
      when /^-----END PUBLIC KEY-----/
        current_mode = nil
        next
      end

      if current_mode == "subject#{i}" || current_mode == "issuer#{i}"
        key, value = line.split("=", 2).map(&:strip) rescue [nil, nil]
        next unless key && value
        case key
        when "userId" then @cert_info[current_mode] += "/UID=#{value}"
        when "commonName" then @cert_info[current_mode] += "/CN=#{value}"
        when "organizationalUnitName" then @cert_info[current_mode] += "/OU=#{value}"
        when "organizationName" then @cert_info[current_mode] += "/O=#{value}"
        when "countryName" then @cert_info[current_mode] += "/C=#{value}"
        end
      end
    end
  rescue => e
    puts "    [ERROR] Failed to process certificate file #{cert_file}: #{e.message}".red
    debug_log "Certificate TXT read error: #{e.class} - #{e.message}" if defined?(debug_log)
  end

  def build_certificate_summary(i)
    @certificate_summary += "##$##&AI#{i}#{@app_id}\n"
    @certificate_summary += "##$##&TI#{i}#{@team_id}\n"
    @certificate_summary += "##$##&SJ#{i}#{@cert_info["subject#{i}"]}\n"
    @certificate_summary += "##$##&IS#{i}#{@cert_info["issuer#{i}"]}\n"
    @certificate_summary += "##$##&SN#{i}#{@cert_info["serial#{i}"]}\n"
    @certificate_summary += "##$##&PK#{i}#{@cert_info["pubkey#{i}"]}\n"
    @certificate_summary += "##$##&VF#{i}#{@cert_info["valid_from#{i}"]}\n"
    @certificate_summary += "##$##&VT#{i}#{@cert_info["valid_to#{i}"]}\n"
  end

  def add_protection_flags
    if defined?($antiswizzle) && $antiswizzle == "enable"
      @certificate_summary += "##&##*ASENABLE\n"
      debug_log "Anti-swizzle flag added" if defined?(debug_log)
    end
    if defined?($antihook) && $antihook == "disable"
      @certificate_summary += "##&##*AHDISABLE\n"
      debug_log "Anti-hook flag added (disabled)" if defined?(debug_log)
    end
    if defined?($securefile) && $securefile == 'enable'
      @certificate_summary += "##&##*SFSENABLE\n"
      debug_log "Secure Filesystem flag added (enabled)" if defined?(debug_log)
    end
  end
end



#--------------------------------------------------------------------------------------------
# Debug / Globals
#--------------------------------------------------------------------------------------------
$debug_mode = ARGV.include?("--debug")
puts "[DEBUG MODE ENABLED]" if $debug_mode
DebugLogger.enable_debug_mode!($debug_mode)

def debug_log(message)
    DebugLogger.debug_log(message)
end

$current_step ||= 0
$LOCAL_TEST = $debug_mode ? true : false

include REXML

$request_param = []
$source_path = []
$enc_strings = {}

LOCAL_TEST = false
$baseURL = 'https://tst-api.appsealing.com/covault/gw/'
$position = 0
$isUnreal = false
$isXamarin = false
$Entitlements = ""

#--------------------------------------------------------------------------------------------
# CLI parsing
#--------------------------------------------------------------------------------------------
if __FILE__ == $0
    cli = AppSealingCLI.new(ARGV)
    cli.parse_and_validate_args!
    $cli_ipa_path = cli.ipa_path
    $cli_options = cli.options
end

#--------------------------------------------------------------------------------------------
# Main flow
#--------------------------------------------------------------------------------------------
begin
    ipa_path = $cli_ipa_path
    raise "IPA file does not exist: #{ipa_path}" unless File.exist?(ipa_path)

    $securefile = $cli_options[:securefile]

    #========================================================================================
    # Step 1: Secure File I/O API Verification
    #========================================================================================
    if defined?($securefile) && $securefile == "enable"
        puts "\n[STEP #{$current_step += 1}] Verifying whether the Secure Filesystem is using only allowed methods...".bold.yellow

        unless File.exist?(SWIFTPM_TARGET)
            puts "    [INFO] By default, Secure Filesystem usage is disabled. To enable this feature, code must be verified to use only allowed methods.".cyan
            puts "    [INFO] Initial verification requires a one-time SwiftSyntax build, which may take several minutes.".cyan
            print "    Do you want to proceed with the SwiftSyntax build now? [Y/n]: ".yellow

            answer = $stdin.gets.chomp.downcase
            if answer == "n" || answer == "no"
                puts "    [INFO] Skipping Secure FileIO verification. Secure Filesystem will be considered disabled.".yellow
                $securefile = "disable"
            end
        end

        if $securefile == "enable"
            project_path = File.expand_path(File.join(__dir__, ".."))
            unless SecureFilesystem.check_secure_fileio(project_path)
                SecureFilesystem.print_allowed_methods
                exit(0)
            end
        end
    else
        puts "    [INFO] Secure Filesystem feature is disabled. To enable, use '-securefile=enable'.".yellow
    end

    #========================================================================================
    # Step 2: Prepare Workspace
    #========================================================================================
    puts "\n[STEP #{$current_step += 1}] Preparing workspace...".bold.yellow

    folder = File.expand_path(File.join(Dir.tmpdir, "AppSealing", SecureRandom.hex)) + "/"
    FileUtils.mkdir_p(folder)

    Dir[File.join(folder, "*")].each { |f| FileUtils.rm_rf(f) }

    package_dir = File.join(folder, "Package")
    ShellUtils.safe_system("unzip -q '#{ipa_path}' -d '#{package_dir}'", "IPA extraction failed")

    app = Dir.glob(File.join(package_dir, "Payload/*.app")).first
    raise "App bundle not found in Payload" unless app && File.directory?(app)

    app_path = app.to_s
    raise "Invalid code signature" unless File.exist?(File.join(app, "_CodeSignature/CodeResources"))

    entitlements_path = File.join(folder, "entitlements.plist")
    ShellUtils.safe_system(
        "codesign -d --entitlements :- '#{app_path}' > '#{entitlements_path}'",
        "Entitlements extraction failed"
    )

    #========================================================================================
    # Step 3: Hermes Validation
    #========================================================================================
    puts "\n[STEP #{$current_step += 1}] Validating Hermes compatibility".bold.yellow

    project_rn_version = HermesValidator.detect_react_native_version_from_project_root
    if project_rn_version
        script_dir = File.expand_path(File.dirname(__FILE__))
        unless HermesValidator.check_and_copy_hermes_files(project_rn_version, script_dir, app_path)
            puts "    [ERROR] Hermes verification failed.".bold.red
            exit(1)
        end
    end

    #========================================================================================
    # Step 4: Modify Info.plist
    #========================================================================================
    puts "\n[STEP #{$current_step += 1}] Modifying Info.plist".bold.yellow

    tmp_info = File.join(folder, "Info.plist")
    ShellUtils.safe_system(
        "/usr/libexec/PlistBuddy -x -c 'Print' '#{app}/Info.plist' > '#{tmp_info}'",
        "Info.plist extraction failed"
    )

    FileUtils.cp(tmp_info, File.join(app, "Info.plist"))
    plist = PlistManager.new(File.join(app, "Info.plist"))

    bundle_id = plist.read("CFBundleIdentifier")
    plist.update_url_scheme($cli_options[:url_scheme]) if $cli_options[:url_scheme]
    plist.update_key("CFBundleShortVersionString", $cli_options[:version]) if $cli_options[:version]
    plist.update_key("NSCameraUsageDescription", $cli_options[:camera_desc]) if $cli_options[:camera_desc]
    plist.save_file

    #============================================================================================
    # Step 5: Extract signature information
    #============================================================================================
    puts "\n[STEP #{$current_step += 1}] Extracting signature information".bold.yellow
    CodeSigner.sign_app_payload(app, folder, true)

    #============================================================================================
    # Step 6: Extract AppSealing account hash
    #============================================================================================
    puts "\n[STEP #{$current_step += 1}] Extracting AppSealing license information".bold.yellow

    lic_app = File.join(app_path, "appsealing.lic")
    lic_fw  = File.join(app_path, "Frameworks/AppSealingFramework.framework", "appsealing.lic")

    result =
        if File.exist?(lic_app)
            StringUtils.get_accountID_hash_from_license_file(lic_app)
        elsif File.exist?(lic_fw)
            StringUtils.get_accountID_hash_from_license_file(lic_fw)
        else
            exe = File.join(app_path, File.basename(app_path, File.extname(app_path)))
            StringUtils.get_accountID_hash_from_unreal_executable(exe)
        end

    sdk_version = result[:sdk_version]
    account_id_hash = result[:account_id_hash]

    #============================================================================================
    # Step 7: Encrypt React Native JavaScript bytecode
    #============================================================================================
    puts "\n[STEP #{$current_step += 1}] Encrypting React Native JavaScript bytecode".bold.yellow

    main_js = File.join(app_path, "main.jsbundle")
    if File.exist?(main_js)
        File.open(main_js, "rb") do |f|
            f.seek(0x7C)
            byte = f.read(1)
            JSBundleEncryptor.encrypt_javascript_bytecode(app, bundle_id) if byte&.bytes&.first == 0
        end
    end

    #============================================================================================
    # Step 8: Codesign app (post-modification)
    #============================================================================================
    puts "\n[STEP #{$current_step += 1}] Codesigning app (post-modification)".bold.yellow
    CodeSigner.sign_app_payload(app, folder, false)

    #============================================================================================
    # Step 9: Extract certificate & provisioning information
    #============================================================================================
    puts "\n[STEP #{$current_step += 1}] Extracting certificate information".bold.yellow

    plist = PlistManager.new(entitlements_path)
    $app_id = plist.read("application-identifier")

    provision = PlistManager.new(File.join(folder, "provision.plist"))
    $team_id = provision.read("TeamIdentifier")&.first

    cert = CertificateExtractor.new(folder, $app_id, $team_id)
    $antihook = $cli_options[:antihook]
    $antiswizzle = $cli_options[:antiswizzle]
    certificate_summary = cert.extract_info

    #============================================================================================
    # Step 10: Generate integrity snapshot
    #============================================================================================
    puts "\n[STEP #{$current_step += 1}] Generating integrity snapshot".bold.yellow

    snapshot = SnapshotBuilder.generate_snapshot(
        certificate_summary,
        File.join(app_path, "_CodeSignature/CodeResources")
    )

    #============================================================================================
    # Step 11: Scan Assets.car
    #============================================================================================
    puts "\n[STEP #{$current_step += 1}] Scanning Assets.car".bold.yellow
    assets = AssetsScanner.scan_assets_car(app)

    #============================================================================================
    # Step 12: Request Genesis file
    #============================================================================================
    puts "\n[STEP #{$current_step += 1}] Requesting genesis file".bold.yellow

    GenesisService.request_genesis(
        snapshot,
        assets,
        {
            account_id_hash: account_id_hash,
            bundle_id: bundle_id,
            sdk_version: sdk_version,
            baseURL: $baseURL,
            app_path: app_path,
            current_step: $current_step
        }
    )

    #============================================================================================
    # Step 13: Re-sign and rebuild IPA
    #============================================================================================
    puts "\n[STEP #{$current_step += 1}] Rebuilding IPA".bold.yellow

    CodeSigner.sign_app_payload(app, folder, false)
    IpaRebuilder.rebuild_and_cleanup(ARGV, folder, app_path)

rescue => e
    puts "\n[ERROR] #{e.message}".red.bold
    exit(false)
end
